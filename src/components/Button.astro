---
import ArrowIcon from './ArrowIcon.astro';
interface Props {
  href?: string;
  variant?: 'primary' | 'secondary' | 'text' | 'solid' | 'outline';
  class?: string;
  type?: 'button' | 'submit' | 'reset';
  disabled?: boolean;
  loading?: boolean;
}
const { href, variant = 'primary', class: className = '', type = 'button', disabled = false, loading = false } = Astro.props;
const normalized = variant === 'solid' ? 'primary' : variant === 'outline' ? 'secondary' : variant;
const classes = `button button--${normalized} ${className}`;
const unavailable = disabled || loading;
---
{href
  ? <a class={classes} href={unavailable ? undefined : href} tabindex={unavailable ? '-1' : undefined} aria-disabled={unavailable ? 'true' : undefined} aria-busy={loading ? 'true' : undefined} data-loading={loading ? '' : undefined}><span class="button__label"><slot /></span><ArrowIcon /></a>
  : <button class={classes} type={type} disabled={unavailable} aria-busy={loading ? 'true' : undefined} data-loading={loading ? '' : undefined}><span class="button__label"><slot /></span><ArrowIcon /></button>}

<style>
  .button { align-items:center; border:1px solid transparent; display:inline-flex; font-size:15px; font-weight:650; gap:14px; justify-content:center; letter-spacing:.01em; min-height:50px; padding:12px 19px; position:relative; text-decoration:none; white-space:nowrap; }
  .button::before { border:1px solid rgba(255,255,255,.18); content:""; inset:2px; pointer-events:none; position:absolute; }
  .button--primary { background:var(--ink); box-shadow:var(--shadow-control); color:#fff; }
  .button--primary:hover { background:#3d4239; box-shadow:0 1px 0 rgba(255,255,255,.5) inset, 0 11px 22px rgba(37,40,36,.12); text-decoration:none; transform:translateY(-1px); }
  .button--primary:active { background:#1c1f1c; box-shadow:var(--shadow-control-pressed); transform:translateY(1px); }
  .button--secondary { background:rgba(250,248,243,.4); border-color:var(--ink); box-shadow:0 1px 0 rgba(255,255,255,.7) inset; color:var(--ink); }
  .button--secondary::before { border-color:rgba(37,40,36,.1); }
  .button--secondary:hover { background:var(--paper); box-shadow:0 7px 16px rgba(37,40,36,.07); text-decoration:none; transform:translateY(-1px); }
  .button--secondary:active { background:var(--paper-deep); box-shadow:var(--shadow-control-pressed); transform:translateY(1px); }
  .button--text { border:0; font-size:14px; min-height:44px; padding:4px 0; }
  .button--text::before { border:0; border-bottom:1px solid currentColor; inset:auto 0 7px; opacity:.45; }
  .button--text:hover::before { opacity:1; transform:scaleX(.72); transform-origin:left; }
  .button[aria-disabled='true'], .button:disabled { box-shadow:none; opacity:.48; pointer-events:none; }
  .button[data-loading] .button__label,.button[data-loading] :global(.icon-arrow) { opacity:.58; }
</style>
