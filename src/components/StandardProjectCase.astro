---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import Button from './Button.astro';
import ProjectGallery from './ProjectGallery.astro';
import PlanToSpace from './PlanToSpace.astro';
import ArrowIcon from './ArrowIcon.astro';
import { withBase } from '../utils/urls';

interface Props { project: Project; next: Project; }
const { project, next } = Astro.props;
const study = project.caseStudy;
const kind = project.kind === 'apartment' ? 'квартира' : 'дом';
const rubles = (value: number) => new Intl.NumberFormat('ru-RU').format(value);
---

<article class="case container">
  <nav class="crumbs" aria-label="Хлебные крошки"><a href={withBase('/projects/')}>Проекты</a><span aria-hidden="true">/</span><span>{project.title}</span></nav>
  <header class="case__header"><p class="eyebrow">{study.status}</p><h1>{project.title}</h1><p class="assignment">{kind} · {project.area} м² · {study.location}</p><p class="scenario">{study.intro}</p></header>
  <figure class="cover"><div class="cover__media"><Image src={project.cover} alt={project.coverAlt} width={1320} quality={70} widths={[640,960,1320,1920]} sizes="(max-width: 767px) calc(100vw - 40px), min(1320px, 100vw - 120px)" loading="eager" fetchpriority="high" /></div><figcaption>{project.coverCaption}</figcaption></figure>
  <section class="decisions"><div><p class="eyebrow">Ключевые решения</p><p class="decisions__lead">Что меняет сценарий жизни в этом пространстве.</p></div><ol>{study.decisions.map((decision) => <li><strong>{decision.title}</strong><span>{decision.text}</span></li>)}</ol></section>
  {study.planToSpace
    ? <PlanToSpace data={study.planToSpace} />
    : <section class="plan-fragment" aria-labelledby="plan-title"><div><p class="eyebrow">Фрагмент планировки</p><h2 id="plan-title">Логика движения и хранения</h2><p>Схема показывает принцип зонирования, а не рабочий чертёж. Детальные листы готовятся под конкретный объект.</p></div><div class="plan-diagram" aria-label="Условная схема помещений"><span class="plan-room plan-room--one">Общая комната</span><span class="plan-room plan-room--two">Кухня</span><span class="plan-room plan-room--three">Хранение</span><span class="plan-room plan-room--four">Окно</span></div></section>}
  {!study.planToSpace && <section class="direction"><ProjectGallery item={project.gallery} /></section>}
  <section class="case-facts"><p class="eyebrow">Параметры концепции</p><div><p><strong>Локация</strong>{study.location}</p><p><strong>Год и статус</strong>{study.year} · {study.status}</p><p><strong>Состав</strong>{study.scope.join(', ')}</p><p><strong>Ориентир срока</strong>{study.duration}</p></div></section>
  <section class="case__next"><p class="eyebrow">Следующий проект</p><a class="inline-link" href={withBase(`/projects/${next.slug}/`)}>{next.title} <ArrowIcon /></a></section>
  <section class="case__cta"><div><p class="eyebrow">Оценка проекта</p><h2>От {rubles(project.pricePerSqm)} ₽/м²</h2><p class="price-total">Для {project.area} м² — ориентир от {rubles(project.estimatedDesignFee)} ₽</p><p class="price-note">Состав, календарь и бюджет обсуждаем до старта работы.</p></div><Button href={withBase('/contact/')}>Обсудить проект</Button></section>
</article>

<style>
  h1,h2 { font-family:var(--font-display); font-weight:400; letter-spacing:-.03em; text-wrap:balance; }
  .case { padding:32px 0 64px; } .crumbs { color:var(--muted); display:flex; font-size:14px; gap:9px; }
  .case__header { padding:56px 0 40px; } h1 { font-size:clamp(52px,7vw,88px); line-height:1.04; margin:10px 0 24px; }
  .assignment { color:var(--muted); font-size:15px; margin:0; } .scenario { font-size:20px; line-height:1.55; margin:24px 0 0; max-width:54ch; }
  .cover { margin:0; } .cover__media { aspect-ratio:3/2; overflow:hidden; } figcaption { color:var(--muted); font-size:14px; margin-top:10px; }
  .decisions { border-top:1px solid var(--line); display:grid; gap:24px; grid-template-columns:3fr 7fr; margin-top:56px; padding-top:16px; } .decisions__lead { color:var(--muted); font-size:15px; max-width:22ch; margin-top:20px; }
  .decisions ol { display:grid; gap:12px; margin:22px 0 0; padding-left:22px; } .decisions li { padding-left:4px; } .decisions strong,.decisions span { display:block; } .decisions span { color:var(--muted); font-size:var(--text-sm); margin-top:4px; }
  .plan-fragment { align-items:start; border-top:1px solid var(--line); display:grid; gap:48px; grid-template-columns:4fr 8fr; margin-top:64px; padding-top:28px; } .plan-fragment h2 { font-size:clamp(30px,4vw,48px); margin:12px 0; } .plan-fragment p { color:var(--muted); font-size:14px; max-width:34ch; } .plan-diagram { aspect-ratio:16/7; background:#e5e2d9; display:grid; grid-template-columns:1.6fr .8fr .5fr; grid-template-rows:1.2fr .7fr; gap:8px; padding:14px; } .plan-room { align-items:center; background:#f7f5ef; border:1px solid #c9c5b8; color:var(--muted); display:flex; font-size:12px; justify-content:center; text-align:center; } .plan-room--one { grid-row:1 / span 2; } .plan-room--four { background:transparent; border:0; font-size:11px; }
  .direction,.case-facts { margin-top:64px; } .case-facts > div { display:grid; gap:16px 24px; grid-template-columns:repeat(4,1fr); margin-top:24px; } .case-facts p { color:var(--muted); font-size:14px; margin:0; } .case-facts strong { color:var(--ink); display:block; font-size:12px; letter-spacing:.06em; margin-bottom:5px; text-transform:uppercase; }
  .case__next { border-top:1px solid var(--line); margin-top:72px; padding-top:24px; } .case__next a { display:inline-block; font-size:24px; margin-top:10px; text-underline-offset:6px; } .case__next :global(.icon-arrow) { margin-left:8px; }
  .case__cta { align-items:end; border-top:1px solid var(--line); display:flex; justify-content:space-between; gap:24px; margin-top:64px; padding-top:48px; } .price-total { font-variant-numeric:tabular-nums; margin:20px 0 8px; } .price-note { color:var(--muted); font-size:14px; max-width:54ch; } .case__cta h2 { max-width:none; margin-top:16px; }
  h2 { font-size:clamp(36px,5vw,58px); line-height:1.1; margin:0; max-width:12ch; }
  @media(max-width:767px) { .case { padding:24px 0 48px; } .case__header { padding:40px 0 32px; } h1 { font-size:48px; } .scenario { font-size:17px; } .cover__media { aspect-ratio:4/3; } .decisions,.direction,.case-facts,.plan-fragment { margin-top:48px; } .decisions,.plan-fragment { display:block; } .decisions__lead { margin:8px 0 18px; } .plan-fragment h2 { font-size:34px; } .plan-diagram { margin-top:28px; aspect-ratio:1.35; } .case-facts > div { grid-template-columns:1fr 1fr; } .case__next { margin-top:48px; } .case__cta { display:block; margin-top:48px; padding-top:40px; } .case__cta :global(.button) { margin-top:28px; width:100%; } }
</style>
