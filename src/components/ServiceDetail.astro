---
import ArrowIcon from './ArrowIcon.astro';
import Button from './Button.astro';
import ServiceEvidence from './ServiceEvidence.astro';
import { projects } from '../data/projects';
import { services,type Service } from '../data/services';
import { sitePath } from '../utils/urls';

interface Props { service: Service }
const { service } = Astro.props;
const serviceIndex = services.findIndex(item => item.slug === service.slug);
if (serviceIndex < 0) throw new Error(`Unknown service: ${service.slug}`);
const nextService = services[(serviceIndex + 1) % services.length];

const relatedEvidence = service.relatedProjects.map((item,index) => {
  const project = projects.find(candidate => candidate.slug === item.projectSlug);
  if (!project) throw new Error(`Unknown related project for ${service.slug}: ${item.projectSlug}`);
  const source = item.source === 'plan'
    ? project.caseStudy.planToSpace
    : project.caseStudy.evidence[item.evidenceIndex ?? 0]?.image;
  if (!source) throw new Error(`Unknown evidence for ${service.slug}: ${item.projectSlug}`);
  const media = 'image' in source
    ? { image:source.image,alt:source.imageAlt }
    : { image:source.src,alt:source.alt };
  return { ...item,...media,project,reverse:index % 2 === 1 };
});
---
<article class="service-detail container">
  <nav class="service-breadcrumb" aria-label="Хлебные крошки">
    <a href={sitePath.services()}>Услуги</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{service.title}</span>
  </nav>

  <header class="service-hero">
    <p class="eyebrow service-hero__label">{service.title}</p>
    <h1>{service.lead}</h1>
    <div class="service-hero__intro">
      <p>{service.problem}</p>
      <p>{service.participation}</p>
    </div>
    <dl class="service-facts">
      <div><dt>В результате</dt><dd>{service.result}</dd></div>
      <div><dt>Срок ориентировочно</dt><dd>{service.term}</dd></div>
      <div><dt>Стоимость ориентировочно</dt><dd>{service.price}</dd></div>
    </dl>
    <div class="service-pricing">
      <p>{service.pricingNote}</p>
      <a class="inline-link" href={sitePath.services()}>Сравнить все услуги <ArrowIcon /></a>
    </div>
  </header>

  <section class="service-fit" aria-labelledby="service-fit-title">
    <header>
      <p class="eyebrow">Граница формата</p>
      <h2 id="service-fit-title">Когда эта услуга достаточна</h2>
    </header>
    <div class="service-fit__columns">
      <div>
        <h3>Подходит, если</h3>
        <p>{service.audience}</p>
      </div>
      <div>
        <h3>Не подойдёт, если</h3>
        <ul>{service.boundaries.map(item => <li>{item}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="service-deliverables" aria-labelledby="service-deliverables-title">
    <header>
      <p class="eyebrow">Что остаётся у вас</p>
      <h2 id="service-deliverables-title">Результат, которым можно пользоваться дальше</h2>
    </header>
    <ol>
      {service.deliverables.map((item,index) => <li>
        <span>{String(index + 1).padStart(2,'0')}</span>
        <div><h3>{item.title}</h3><p>{item.text}</p></div>
      </li>)}
    </ol>
  </section>

  <section class="service-process" aria-labelledby="service-process-title">
    <header>
      <p class="eyebrow">Короткий процесс</p>
      <h2 id="service-process-title">Как проходит работа</h2>
      <p>На каждом шаге сначала сверяем решение, затем фиксируем его. Следующий этап не начинается на неподтверждённой основе.</p>
    </header>
    <ol class="service-process__steps">
      {service.sequence.map((item,index) => <li>
        <span>{String(index + 1).padStart(2,'0')}</span>
        <div><h3>{item.title}</h3><p>{item.text}</p></div>
      </li>)}
    </ol>
    <aside class="service-inputs" aria-labelledby="service-inputs-title">
      <p class="eyebrow">Что подготовить</p>
      <h3 id="service-inputs-title">Вводные для первого разговора</h3>
      <ul>{service.requiredInputs.map(item => <li>{item}</li>)}</ul>
    </aside>
  </section>

  <section class="service-proof" aria-labelledby="service-proof-title">
    <header>
      <p class="eyebrow">Доказательства в проектах</p>
      <h2 id="service-proof-title">Как этот уровень работы читается в пространстве</h2>
      <p>Кейсы показывают связь задачи, выбранного приёма и наблюдаемого результата.</p>
    </header>
    {relatedEvidence.map(item => <ServiceEvidence
      href={sitePath.project(item.project.slug)}
      label={item.label}
      title={item.title}
      text={item.text}
      projectTitle={item.project.title}
      image={item.image}
      alt={item.alt}
      reverse={item.reverse}
    />)}
  </section>

  {service.faq && service.faq.length > 0 && <section class="service-faq" aria-labelledby="service-faq-title">
    <header>
      <p class="eyebrow">Важная граница</p>
      <h2 id="service-faq-title">Вопрос именно об этом формате</h2>
    </header>
    <div>
      {service.faq.map(item => <details>
        <summary>{item.question}</summary>
        <p>{item.answer}</p>
      </details>)}
    </div>
  </section>}

  <aside class="service-next" aria-label="Другая услуга">
    <div>
      <p class="eyebrow">Другой уровень участия</p>
      <h2>{nextService.title}</h2>
      <p>{nextService.lead}</p>
    </div>
    <a class="inline-link" href={sitePath.service(nextService.slug)}>Перейти к услуге <ArrowIcon /></a>
  </aside>

  <section class="service-cta">
    <div>
      <p class="eyebrow">Первый разговор</p>
      <h2>Определим достаточный состав работы</h2>
      <p>Пришлите план и коротко опишите задачу. На старте важнее понять ограничения, чем заранее выбрать самый большой формат.</p>
    </div>
    <Button href={sitePath.contact()}>Обсудить проект</Button>
  </section>
</article>

<style>
  .service-detail { padding:var(--space-6) 0 var(--space-8); }
  .service-detail h1,.service-detail h2,.service-detail h3 { font-family:var(--font-display); font-weight:400; letter-spacing:-.03em; }
  .service-breadcrumb { align-items:center; color:var(--muted); display:flex; flex-wrap:wrap; font-size:var(--text-sm); gap:8px; margin-bottom:var(--space-8); }
  .service-breadcrumb a { min-height:44px; align-items:center; display:inline-flex; }
  .service-breadcrumb span:last-child { overflow-wrap:anywhere; }
  .service-hero { display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); }
  .service-hero__label { grid-column:1 / span 3; padding-top:14px; }
  .service-hero h1 { font-size:clamp(3.4rem,6.2vw,5.7rem); grid-column:4 / span 9; line-height:1.03; margin:0; max-width:12ch; text-wrap:balance; }
  .service-hero__intro { grid-column:4 / span 6; margin-top:var(--space-5); }
  .service-hero__intro p { font-size:var(--text-lead); line-height:1.65; margin:0; }
  .service-hero__intro p + p { color:var(--muted); font-size:var(--text-body); margin-top:var(--space-3); }
  .service-facts { border-top:1px solid var(--line); display:grid; gap:var(--grid-gap); grid-column:1 / -1; grid-template-columns:repeat(3,minmax(0,1fr)); margin:var(--space-7) 0 0; padding-top:var(--space-4); }
  .service-facts div { min-width:0; }
  .service-facts dt { color:var(--muted); font-size:var(--text-xs); font-weight:600; letter-spacing:.04em; margin-bottom:7px; text-transform:uppercase; }
  .service-facts dd { font-size:var(--text-body); line-height:1.5; margin:0; max-width:34ch; }
  .service-pricing { align-items:start; display:grid; gap:var(--grid-gap); grid-column:4 / span 9; grid-template-columns:2fr 1fr; margin-top:var(--space-3); }
  .service-pricing p { color:var(--muted); font-size:var(--text-sm); line-height:1.65; margin:0; max-width:58ch; }
  .service-pricing .inline-link { justify-self:end; white-space:nowrap; }
  .service-fit,.service-deliverables,.service-process,.service-proof,.service-faq,.service-next,.service-cta { border-top:1px solid var(--line); margin-top:var(--section-space); padding-top:var(--space-7); }
  .service-fit,.service-deliverables,.service-process,.service-faq { display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); }
  .service-fit > header,.service-deliverables > header,.service-process > header,.service-faq > header { grid-column:1 / span 5; }
  .service-detail h2 { font-size:var(--title-section); line-height:1.1; margin:var(--space-2) 0 0; text-wrap:balance; }
  .service-fit > header h2,.service-deliverables > header h2,.service-process > header h2,.service-faq > header h2 { max-width:15ch; }
  .service-fit__columns { display:grid; gap:var(--space-6); grid-column:7 / span 6; grid-template-columns:1fr 1fr; }
  .service-fit__columns > div { border-top:1px solid var(--line); padding-top:var(--space-3); }
  .service-fit h3,.service-deliverables h3,.service-process h3,.service-inputs h3 { font-size:clamp(1.35rem,2vw,1.75rem); line-height:1.2; margin:0; }
  .service-fit p,.service-fit li,.service-deliverables p,.service-process p,.service-process li { color:var(--muted); font-size:var(--text-sm); line-height:1.7; }
  .service-fit ul,.service-inputs ul { margin:var(--space-3) 0 0; padding-left:20px; }
  .service-fit li + li,.service-inputs li + li { margin-top:8px; }
  .service-deliverables > ol { grid-column:7 / span 6; list-style:none; margin:0; padding:0; }
  .service-deliverables > ol > li,.service-process__steps > li { border-top:1px solid var(--line); display:grid; gap:var(--space-3); grid-template-columns:38px 1fr; padding:var(--space-4) 0; }
  .service-deliverables > ol > li:first-child,.service-process__steps > li:first-child { border-top:0; padding-top:0; }
  .service-deliverables li > span,.service-process__steps li > span { color:var(--accent-ink); font-size:var(--text-xs); font-weight:700; padding-top:6px; }
  .service-deliverables li p,.service-process__steps li p { margin:var(--space-2) 0 0; max-width:46ch; }
  .service-process > header > p:last-child { color:var(--muted); line-height:1.7; margin:var(--space-4) 0 0; max-width:38ch; }
  .service-process__steps { grid-column:7 / span 6; list-style:none; margin:0; padding:0; }
  .service-inputs { background:color-mix(in srgb,var(--surface) 70%,transparent); grid-column:7 / span 6; margin-top:var(--space-5); padding:var(--space-5); }
  .service-inputs h3 { margin-top:var(--space-2); }
  .service-proof > header { display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); padding-bottom:var(--space-4); }
  .service-proof > header .eyebrow { grid-column:1 / span 3; }
  .service-proof > header h2 { grid-column:4 / span 6; max-width:16ch; }
  .service-proof > header > p:last-child { color:var(--muted); grid-column:10 / span 3; line-height:1.65; margin:0; }
  .service-faq > div { grid-column:7 / span 6; }
  .service-faq details { border-top:1px solid var(--line); }
  .service-faq summary { cursor:pointer; font-family:var(--font-display); font-size:clamp(1.3rem,2vw,1.7rem); line-height:1.3; min-height:64px; padding:18px 42px 18px 0; position:relative; }
  .service-faq summary::marker { color:var(--accent-ink); }
  .service-faq details p { color:var(--muted); line-height:1.7; margin:0; max-width:48ch; padding:0 0 var(--space-4); }
  .service-next { align-items:end; display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); }
  .service-next > div { grid-column:1 / span 7; }
  .service-next h2 { margin-bottom:var(--space-2); }
  .service-next > div > p:last-child { color:var(--muted); margin:0; max-width:46ch; }
  .service-next > .inline-link { grid-column:10 / span 3; justify-self:end; }
  .service-cta { align-items:end; display:flex; justify-content:space-between; }
  .service-cta h2 { margin-bottom:var(--space-3); max-width:15ch; }
  .service-cta > div > p:last-child { color:var(--muted); line-height:1.65; margin:0; max-width:48ch; }
  @media(max-width:1023px){
    .service-hero h1 { grid-column:4 / span 9; }
    .service-hero__intro,.service-pricing { grid-column:4 / span 8; }
    .service-fit > header,.service-deliverables > header,.service-process > header,.service-faq > header { grid-column:1 / span 4; }
    .service-fit__columns,.service-deliverables > ol,.service-process__steps,.service-faq > div { grid-column:6 / span 7; }
    .service-inputs { grid-column:6 / span 7; }
    .service-proof > header h2 { grid-column:4 / span 8; }
    .service-proof > header > p:last-child { grid-column:4 / span 7; margin-top:var(--space-3); }
  }
  @media(max-width:767px){
    .service-detail { padding:var(--space-4) 0 var(--space-7); }
    .service-breadcrumb { margin-bottom:var(--space-6); }
    .service-hero,.service-fit,.service-deliverables,.service-process,.service-proof > header,.service-faq,.service-next { display:block; }
    .service-hero h1 { font-size:clamp(2.5rem,12vw,3.45rem); hyphens:auto; margin-top:var(--space-2); max-width:11ch; overflow-wrap:break-word; }
    .service-hero__intro { margin-top:var(--space-4); }
    .service-facts { gap:var(--space-4); grid-template-columns:1fr; margin-top:var(--space-6); }
    .service-pricing { display:block; margin-top:var(--space-4); }
    .service-pricing .inline-link { margin-top:var(--space-3); }
    .service-fit,.service-deliverables,.service-process,.service-proof,.service-faq,.service-next,.service-cta { margin-top:var(--space-7); padding-top:var(--space-6); }
    .service-detail h2 { font-size:clamp(2.1rem,9.5vw,2.6rem); }
    .service-fit__columns { gap:var(--space-5); grid-template-columns:1fr; margin-top:var(--space-5); }
    .service-deliverables > ol,.service-process__steps,.service-faq > div { margin-top:var(--space-5); }
    .service-inputs { margin-top:var(--space-5); padding:var(--space-4); }
    .service-proof > header > p:last-child { margin-top:var(--space-3); }
    .service-next > .inline-link { margin-top:var(--space-4); }
    .service-cta { align-items:start; display:block; }
    .service-cta :global(.button) { margin-top:var(--space-5); width:100%; }
  }
  @media(max-width:359px){
    .service-hero h1 { font-size:2.35rem !important; hyphens:auto; line-height:1.08; max-width:none; overflow-wrap:break-word; }
    .service-hero__label { overflow-wrap:anywhere; }
  }
</style>
