---
import ArrowIcon from './ArrowIcon.astro';
import { withBase } from '../utils/urls';
---
<form class="inquiry" novalidate data-inquiry id="consultation">
  <div class="inquiry__progress" hidden>
    <span data-progress>Шаг 1 из 2</span>
    <ol aria-label="Этапы обращения">
      <li class="is-active" aria-current="step"><span>01</span><b>Связь</b></li>
      <li><span>02</span><b>Проект</b></li>
    </ol>
  </div>

  <fieldset data-step>
    <legend tabindex="-1">Как к вам обратиться</legend>
    <p class="hint">Нужны только имя и один удобный способ связи. Можно оставить телефон, email или оба.</p>
    <div class="grid">
      <label class="field wide"><span>Имя <small>обязательно</small></span><input name="name" type="text" required autocomplete="name" aria-describedby="name-error" /><i id="name-error"></i></label>
      <label class="field"><span>Телефон <small>необязательно</small></span><input name="phone" type="tel" inputmode="tel" autocomplete="tel" placeholder="+7 999 123-45-67" aria-describedby="contact-note phone-error contact-error" /><i id="phone-error"></i></label>
      <label class="field"><span>Email <small>необязательно</small></span><input name="email" type="email" autocomplete="email" placeholder="name@example.ru" aria-describedby="contact-note email-error contact-error" /><i id="email-error"></i></label>
    </div>
    <p class="contact-note" id="contact-note">Формат проверяется только по записи: сайт не проверяет, существует ли номер или адрес.</p>
    <p class="contact-error" id="contact-error" aria-live="polite"></p>
  </fieldset>

  <fieldset data-step>
    <legend tabindex="-1">Что уже известно о проекте</legend>
    <p class="hint">Все поля на этом шаге необязательны. Заполните только то, что поможет начать разговор.</p>
    <div class="grid">
      <label class="field"><span>Тип объекта <small>необязательно</small></span><select name="type" aria-describedby="type-error"><option value="">Не выбран</option><option>Квартира</option><option>Загородный дом</option><option>Апартаменты</option></select><i id="type-error"></i></label>
      <label class="field"><span>Услуга <small>необязательно</small></span><select name="service" aria-describedby="service-error"><option value="">Не выбрана</option><option>Планировочное решение</option><option>Полный дизайн-проект</option><option>Комплектация</option><option>Авторский надзор</option><option>Консультация</option></select><i id="service-error"></i></label>
      <label class="field wide"><span>Площадь, м² <small>необязательно</small></span><input name="area" type="text" inputmode="decimal" autocomplete="off" aria-describedby="area-error" /><i id="area-error"></i></label>
    </div>

    <details class="optional" data-optional open>
      <summary>Добавить контекст</summary>
      <div class="optional__content grid">
        <label class="field"><span>Ориентировочный бюджет <small>необязательно</small></span><select name="budget" aria-describedby="budget-error"><option value="">Не выбран</option><option>до 500 000 ₽</option><option>500 000–1,5 млн ₽</option><option>1,5–3 млн ₽</option><option>обсудить в разговоре</option></select><i id="budget-error"></i></label>
        <label class="field"><span>Город или район <small>необязательно</small></span><input name="location" type="text" autocomplete="off" placeholder="Например, Петроградский район" aria-describedby="location-error" /><i id="location-error"></i></label>
        <label class="field"><span>Состояние объекта <small>необязательно</small></span><select name="condition" aria-describedby="condition-error"><option value="">Не выбрано</option><option>Новостройка без отделки</option><option>Вторичное жильё</option><option>Идёт ремонт</option><option>Нужна только консультация</option></select><i id="condition-error"></i></label>
        <label class="field"><span>Желаемый старт <small>необязательно</small></span><select name="start" aria-describedby="start-error"><option value="">Не выбран</option><option>В ближайший месяц</option><option>Через 1–3 месяца</option><option>Позже</option></select><i id="start-error"></i></label>
        <label class="field wide"><span>Комментарий <small>необязательно</small></span><textarea name="comment" rows="3" placeholder="Что особенно важно учесть?"></textarea></label>
      </div>
      <label class="upload"><input name="files" type="file" multiple accept="image/*,.pdf" aria-describedby="files-note files-error" /><span class="upload__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8.5 12.5l5.9-5.9a3 3 0 014.2 4.2l-8.1 8.1a5 5 0 01-7.1-7.1l8.5-8.5" /></svg></span><span class="upload__copy"><b>План, фотографии или референсы</b><small id="files-note">Необязательно · до 6 файлов по 10 МБ. Сайт показывает только названия, не читает содержимое и никуда их не передаёт.</small><em data-files>Выбрать файлы</em></span><i id="files-error"></i></label>
    </details>

    <details class="optional" data-optional open>
      <summary>Добавить предпочтение по разговору</summary>
      <div class="optional__content">
        <p class="preference-note">Это только удобный для вас вариант. Время не резервируется и не считается подтверждённым.</p>
        <div class="grid">
          <label class="field"><span>Дата <small>необязательно</small></span><input name="date" type="date" aria-describedby="date-error" /><i id="date-error"></i></label>
          <label class="field"><span>Время <small>необязательно</small></span><select name="time" aria-describedby="time-error"><option value="">Не выбрано</option><option>11:00</option><option>13:30</option><option>16:00</option><option>18:30</option></select><i id="time-error"></i></label>
          <label class="field wide"><span>Формат <small>необязательно</small></span><select name="format" aria-describedby="format-error"><option value="">Не выбран</option><option>В студии</option><option>Видеовстреча</option><option>Телефонный разговор</option></select><i id="format-error"></i></label>
        </div>
      </div>
    </details>
  </fieldset>

  <section class="review" hidden data-review aria-labelledby="inquiry-review-title"></section>
  <p class="privacy-note">Введённое остаётся в этом окне и не отправляется. Подробнее — в <a href={withBase('/privacy/')}>описании конфиденциальности</a>.</p>
  <div class="inquiry__actions" hidden><button type="button" class="form-button form-button--secondary back" data-back hidden><ArrowIcon /><span>Назад</span></button><button type="button" class="form-button form-button--primary next" data-next><span>Продолжить</span><ArrowIcon /></button><button type="submit" class="form-button form-button--primary submit" disabled hidden><span>Проверить сводку</span><ArrowIcon /></button></div>
  <p class="status" role="status" aria-live="polite"></p>
  <noscript><p class="no-script">Поля и контакты доступны, но сводка собирается только в текущем окне при включённом JavaScript. Ничего не отправляется автоматически: для разговора используйте телефон или email рядом с формой.</p></noscript>
</form>
<script src="../scripts/demo-inquiry.ts"></script>
<style>
  .inquiry{background:color-mix(in srgb,var(--surface) 78%,transparent);border:1px solid var(--line);box-shadow:var(--shadow-raised);padding:clamp(22px,3.4vw,42px)}.inquiry__progress{align-items:start;display:grid;gap:22px;grid-template-columns:auto 1fr;margin-bottom:42px}.inquiry__progress>span{color:var(--muted);font-size:12px;font-weight:650;letter-spacing:.06em;padding-top:9px;text-transform:uppercase;white-space:nowrap}.inquiry ol{display:grid;grid-template-columns:repeat(2,1fr);list-style:none;margin:0;padding:0}.inquiry li{border-top:1px solid var(--line);color:var(--muted);display:grid;font-size:11px;gap:2px;padding:8px 8px 0 0;position:relative}.inquiry li::before{background:var(--ink);content:"";height:2px;left:0;position:absolute;top:-1px;transform:scaleX(0);transform-origin:left;transition:transform var(--duration-flow) var(--ease-ui);width:100%}.inquiry li span{font-variant-numeric:tabular-nums}.inquiry li b{font-size:12px;font-weight:550}.inquiry li.is-active,.inquiry li.is-complete{color:var(--ink)}.inquiry li.is-active::before,.inquiry li.is-complete::before{transform:scaleX(1)}.inquiry li.is-complete::before{background:var(--olive)}
  fieldset{border:0;margin:0;padding:0}fieldset[hidden]{display:none}.inquiry:not([data-enhanced]) [data-step]+[data-step]{margin-top:42px}legend{font-family:Prata,Georgia,serif;font-size:clamp(28px,3vw,38px);line-height:1.15;margin-bottom:12px}.grid{display:grid;gap:20px;grid-template-columns:1fr 1fr}.field{display:block;font-size:13px;font-weight:650}.field>span{display:block;min-height:21px}.field small{color:var(--muted);font-size:11px;font-weight:450}.field input,.field select,.field textarea{appearance:none;background-color:rgba(250,248,243,.34);border:1px solid var(--control-line);border-radius:0;box-shadow:0 1px 0 rgba(255,255,255,.58) inset;display:block;margin-top:7px;min-height:52px;padding:12px 13px;width:100%}.field select{background-image:linear-gradient(45deg,transparent 50%,var(--muted) 50%),linear-gradient(135deg,var(--muted) 50%,transparent 50%);background-position:calc(100% - 17px) 23px,calc(100% - 12px) 23px;background-repeat:no-repeat;background-size:5px 5px,5px 5px;padding-right:38px}.field textarea{min-height:108px;resize:vertical}.field input:hover,.field select:hover,.field textarea:hover{background-color:rgba(250,248,243,.72);border-color:var(--muted)}.field input:focus,.field select:focus,.field textarea:focus{background-color:var(--paper);border-color:var(--focus);box-shadow:0 0 0 3px rgba(79,92,69,.12),0 1px 0 #fff inset}.field.is-valid input,.field.is-valid select,.field.is-valid textarea{border-color:rgba(82,99,75,.72)}.field [aria-invalid='true']{background:#fbf3f1;border-color:var(--error);box-shadow:0 0 0 3px rgba(150,59,52,.08)}.field i,.upload>i{color:var(--error);display:block;font-size:12px;font-style:normal;font-weight:550;line-height:1.4;margin-top:6px;min-height:17px}.wide{grid-column:1/-1}.hint{color:var(--muted);font-size:14px;margin:0 0 26px;max-width:58ch}.contact-note{color:var(--muted);font-size:12px;margin:2px 0 0}.contact-error{color:var(--error);font-size:12px;font-weight:550;margin:5px 0 0;min-height:17px}
  .optional{border-top:1px solid var(--line);margin-top:28px;padding-top:2px}.optional summary{cursor:pointer;font-size:14px;font-weight:650;list-style:none;min-height:50px;padding:15px 36px 12px 0;position:relative}.optional summary::-webkit-details-marker{display:none}.optional summary::after{border-bottom:1px solid currentColor;border-right:1px solid currentColor;content:"";height:8px;position:absolute;right:5px;top:18px;transform:rotate(45deg);transition:transform var(--duration-fast) var(--ease-ui);width:8px}.optional[open] summary::after{transform:rotate(225deg);top:23px}.optional__content{padding:8px 0 2px}.preference-note{color:var(--muted);font-size:13px;margin:0 0 18px;max-width:58ch}
  .upload{align-items:center;background:rgba(250,248,243,.34);border:1px dashed var(--control-line);cursor:pointer;display:grid;gap:0 16px;grid-template-columns:42px 1fr;margin-top:22px;min-height:112px;padding:18px;position:relative;transition:background-color var(--duration-ui) var(--ease-ui),border-color var(--duration-ui) var(--ease-ui),box-shadow var(--duration-ui) var(--ease-ui)}.upload:hover,.upload:focus-within{background:var(--paper);border-color:var(--ink);box-shadow:0 7px 18px rgba(37,40,36,.06)}.upload input{cursor:pointer;height:100%;inset:0;opacity:0;position:absolute;width:100%;z-index:1}.upload__icon{align-items:center;border:1px solid var(--line);display:flex;height:42px;justify-content:center;width:42px}.upload__icon svg{fill:none;height:20px;stroke:currentColor;stroke-linecap:square;stroke-width:1.4;width:20px}.upload__copy{min-width:0}.upload__copy b,.upload__copy small,.upload__copy em{display:block}.upload__copy b{font-size:13px}.upload__copy small{color:var(--muted);font-size:12px;font-weight:450;margin-top:2px}.upload__copy em{font-size:13px;font-style:normal;margin-top:8px;overflow-wrap:anywhere;text-decoration:underline;text-underline-offset:4px}.upload>i{grid-column:2}.upload.has-error{background:#fbf3f1;border-color:var(--error)}.upload.has-files{border-color:var(--success)}
  .privacy-note{border-top:1px solid var(--line);color:var(--muted);font-size:12px;line-height:1.55;margin:34px 0 0;padding-top:16px}.inquiry__actions{display:flex;gap:12px;justify-content:flex-end;margin-top:20px}.form-button{align-items:center;border:1px solid var(--ink);display:inline-flex;font-size:14px;font-weight:650;gap:13px;justify-content:center;min-height:50px;padding:11px 18px;position:relative}.form-button::before{border:1px solid rgba(255,255,255,.18);content:"";inset:2px;pointer-events:none;position:absolute}.form-button:disabled{cursor:default;opacity:.55}.form-button--primary{background:var(--ink);box-shadow:var(--shadow-control);color:#fff}.form-button.form-button--primary:active{box-shadow:var(--shadow-control-pressed);transform:translateY(1px)}.form-button--secondary{background:transparent;box-shadow:0 1px 0 rgba(255,255,255,.7) inset}.form-button--secondary::before{border-color:rgba(37,40,36,.08)}.form-button.form-button--secondary:active{background:var(--paper-deep);box-shadow:var(--shadow-control-pressed);transform:translateY(1px)}.back :global(.icon-arrow){transform:rotate(180deg)}
  .status{color:var(--error);font-size:13px;margin:15px 0 0;min-height:21px}.review{background:var(--paper);border:1px solid var(--line);box-shadow:0 14px 30px rgba(37,40,36,.06);padding:26px}.review :global(h2){font-family:Prata,Georgia,serif;font-size:clamp(28px,3vw,36px);font-weight:400;line-height:1.15;margin:0 0 10px}.review :global(.review__intro){color:var(--muted);font-size:14px;margin:0 0 22px;max-width:58ch}.review :global(dl){border-top:1px solid var(--line);display:grid;margin:0}.review :global(dl>div){border-bottom:1px solid rgba(212,210,200,.62);display:grid;gap:16px;grid-template-columns:150px 1fr;padding:9px 0}.review :global(dt){color:var(--muted);font-size:12px}.review :global(dd){font-size:14px;margin:0;overflow-wrap:anywhere}.review :global(.review__notice){border-left:2px solid var(--success);margin-top:22px;padding:3px 0 3px 18px}.review :global(.review__notice strong){display:block;font-family:Prata,Georgia,serif;font-size:22px;font-weight:400}.review :global(.review__notice p){color:var(--muted);font-size:14px;margin:8px 0 0;max-width:58ch}.review :global(.review__edit){background:transparent;border:0;border-bottom:1px solid currentColor;font-size:13px;font-weight:650;margin-top:18px;min-height:38px;padding:4px 0}.review :global(.review__edit:hover){border-bottom-color:transparent}.no-script{border:1px solid var(--line);font-size:14px;padding:16px}
  @media(hover:hover){.form-button--primary:hover{background:#3d4239;box-shadow:0 10px 20px rgba(37,40,36,.12);transform:translateY(-1px)}.form-button--secondary:hover{background:var(--paper);box-shadow:0 7px 16px rgba(37,40,36,.06);transform:translateY(-1px)}.back:hover :global(.icon-arrow),.back:focus-visible :global(.icon-arrow){transform:rotate(180deg) translateX(3px)}}
  @media(min-width:768px) and (max-width:860px){.inquiry{padding:var(--space-4)}.grid{grid-template-columns:1fr}.wide{grid-column:auto}.inquiry__progress{grid-template-columns:1fr}.inquiry__progress>span{padding-top:0}.privacy-note{margin-top:var(--space-4)}}
  @media(max-width:767px){.inquiry{padding:22px 18px}.inquiry__progress{display:block;margin-bottom:34px}.inquiry__progress>span{display:block;font-size:13px;padding:0 0 10px}.inquiry li,.inquiry li b{font-size:13px}.grid{grid-template-columns:1fr}.wide{grid-column:auto}.field{font-size:14px}.field small{font-size:13px}.field i,.upload>i,.contact-note,.contact-error{font-size:13px}.hint{font-size:16px}.optional summary{font-size:16px}.preference-note{font-size:14px}.upload{grid-template-columns:44px 1fr;padding:15px}.upload__icon{height:44px;width:44px}.upload__copy b,.upload__copy em{font-size:14px}.upload__copy small,.privacy-note{font-size:13px}.form-button{font-size:16px}.status{font-size:14px}.inquiry__actions{display:grid;grid-template-columns:1fr 1.45fr}.inquiry__actions .back[hidden]+.next{grid-column:1/-1}.review{padding:20px}.review :global(.review__intro),.review :global(dd),.review :global(.review__notice p){font-size:16px}.review :global(dt){font-size:13px}.review :global(.review__edit){font-size:14px;min-height:44px}.review :global(dl>div){gap:2px;grid-template-columns:1fr}.no-script{font-size:16px}}
</style>
