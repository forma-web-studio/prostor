---
import type { Project } from '../data/projects';
import { Image } from 'astro:assets';
import { withBase } from '../utils/urls';
interface Props { project: Project; size?: 'large' | 'small'; linked?: boolean; class?: string; sizes?: string; }
const { project, size = 'large', linked = false, class: className = '', sizes = '(max-width: 767px) calc(100vw - 40px), (min-width: 1440px) 648px, calc((100vw - 120px) / 2)' } = Astro.props;
const kind = project.kind === 'apartment' ? 'Квартира' : 'Дом';
const formatPrice = (value: number) => new Intl.NumberFormat('ru-RU').format(value);
---
<article class={`project-card project-card--${size} ${className}`}>
  {linked ? <a class="project-card__link" href={withBase(`/projects/${project.slug}/`)}><span class="project-card__image"><Image src={project.cover} alt={project.coverAlt} width={1200} widths={[480, 800, 1200]} sizes={sizes} quality={70} loading="lazy" style={`object-position:${project.coverPosition ?? '50% 50%'}`} /></span><div class="project-card__info"><div class="project-card__heading"><p class="project-card__style">{project.style}</p><h3>{project.title}</h3><p class="project-card__meta">{kind} · {project.area} м²</p></div><p class="project-card__price"><span>Дизайн от {formatPrice(project.pricePerSqm)} ₽/м²</span><strong>Ориентир: {formatPrice(project.estimatedDesignFee)} ₽</strong></p></div></a> : <><div class="project-card__image"><Image src={project.cover} alt={project.coverAlt} width={1200} widths={[480, 800, 1200]} sizes="(max-width: 767px) calc(100vw - 40px), 35vw" loading="lazy" /></div><div class="project-card__info"><div class="project-card__heading"><p class="project-card__style">{project.style}</p><h3>{project.title}</h3><p class="project-card__meta">{kind} · {project.area} м²</p></div><p class="project-card__price"><span>Дизайн от {formatPrice(project.pricePerSqm)} ₽/м²</span><strong>Ориентир: {formatPrice(project.estimatedDesignFee)} ₽</strong></p></div></>}
</article>
<style>
  .project-card__link { display:block; color:inherit; text-decoration:none; } .project-card__image { display:block; overflow:hidden; background:#dedad1; } .project-card--large .project-card__image { aspect-ratio:3/2; } .project-card--small .project-card__image { aspect-ratio:4/5; }
  img { transition:transform .45s cubic-bezier(.2,.65,.3,1); } a:hover img,a:focus-visible img { transform:scale(1.025); } .project-card__info { align-items:end; display:flex; gap:24px; justify-content:space-between; padding-top:16px; } .project-card__heading { min-width:0; } h3 { font-family:Prata,Georgia,serif; font-size:clamp(22px, 2vw, 29px); font-weight:400; letter-spacing:-.025em; line-height:1.2; margin:3px 0 0; } a:hover h3,a:focus-visible h3 { text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:5px; } .project-card__style { color:#786e60; font-size:12px; letter-spacing:.08em; line-height:1.2; margin:0; text-transform:uppercase; } .project-card__meta { color:var(--muted); font-size:14px; margin:7px 0 0; } .project-card__price { color:var(--muted); flex:0 0 auto; font-size:12px; line-height:1.45; margin:0; text-align:right; white-space:nowrap; } .project-card__price span,.project-card__price strong { display:block; } .project-card__price strong { color:var(--ink); font-size:14px; font-weight:500; margin-top:2px; }
  @media(max-width:767px) { .project-card__info { align-items:start; display:block; } .project-card__price { margin-top:16px; text-align:left; } .project-card--small .project-card__image { aspect-ratio:3/2; } }
</style>

