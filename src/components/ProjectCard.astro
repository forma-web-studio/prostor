---
import type { Project } from '../data/projects';
import { Image } from 'astro:assets';
import { withBase } from '../utils/urls';
interface Props { project: Project; size?: 'large' | 'small'; linked?: boolean; editorial?: boolean; headingLevel?: 'h2' | 'h3'; class?: string; sizes?: string; }
const { project, size = 'large', linked = false, editorial = false, headingLevel = 'h3', class: className = '', sizes = '(max-width: 767px) calc(100vw - 40px), (min-width: 1440px) 648px, calc((100vw - 120px) / 2)' } = Astro.props;
const Heading = headingLevel;
const kind = project.kind === 'apartment' ? 'Квартира' : 'Дом';
const formatPrice = (value: number) => new Intl.NumberFormat('ru-RU').format(value);
---
<article class={`project-card project-card--${size} ${editorial ? 'project-card--editorial' : ''} ${className}`}>
  {linked ? <a class="project-card__link" href={withBase(`/projects/${project.slug}/`)}><span class="project-card__image"><Image src={project.cover} alt={project.coverAlt} width={1200} widths={[480, 800, 1200]} sizes={sizes} quality={70} loading="lazy" style={`object-position:${project.coverPosition ?? '50% 50%'}`} /></span><div class="project-card__info"><div class="project-card__heading"><p class="project-card__style">{project.style}</p><Heading>{project.title}</Heading><p class="project-card__meta">{kind} · {project.area} м²</p>{editorial && <p class="project-card__summary">{project.summary}</p>}</div>{editorial ? <span class="project-card__action">Смотреть проект</span> : <div class="project-card__price"><span>Ориентир дизайн-проекта</span><strong>{formatPrice(project.estimatedDesignFee)} ₽</strong><small>от {formatPrice(project.pricePerSqm)} ₽/м²</small></div>}</div></a> : <><div class="project-card__image"><Image src={project.cover} alt={project.coverAlt} width={1200} widths={[480, 800, 1200]} sizes="(max-width: 767px) calc(100vw - 40px), 35vw" loading="lazy" /></div><div class="project-card__info"><div class="project-card__heading"><p class="project-card__style">{project.style}</p><Heading>{project.title}</Heading><p class="project-card__meta">{kind} · {project.area} м²</p></div><div class="project-card__price"><span>Ориентир дизайн-проекта</span><strong>{formatPrice(project.estimatedDesignFee)} ₽</strong><small>от {formatPrice(project.pricePerSqm)} ₽/м²</small></div></div></>}
</article>
<style>
  .project-card__link { display:block; color:inherit; text-decoration:none; } .project-card__image { display:block; overflow:hidden; background:#dedad1; } .project-card--large .project-card__image { aspect-ratio:3/2; } .project-card--small .project-card__image { aspect-ratio:4/5; }
  img { transition:transform .45s cubic-bezier(.2,.65,.3,1); } a:hover img,a:focus-visible img { transform:scale(1.025); } .project-card__info { align-items:end; display:flex; gap:24px; justify-content:space-between; padding-top:16px; } .project-card__heading { min-width:0; } h2,h3 { font-family:Prata,Georgia,serif; font-size:clamp(22px, 2vw, 29px); font-weight:400; letter-spacing:-.025em; line-height:1.2; margin:3px 0 0; } a:hover :is(h2,h3),a:focus-visible :is(h2,h3) { text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:5px; } .project-card__style { color:#786e60; font-size:12px; letter-spacing:.08em; line-height:1.2; margin:0; text-transform:uppercase; } .project-card__meta { color:var(--muted); font-size:14px; margin:7px 0 0; } .project-card__price { border-left:1px solid var(--line); color:var(--muted); flex:0 0 auto; font-size:11px; line-height:1.4; margin:0; padding-left:16px; text-align:right; white-space:nowrap; } .project-card__price span,.project-card__price strong,.project-card__price small { display:block; } .project-card__price strong { color:var(--ink); font-size:15px; font-weight:600; margin-top:3px; } .project-card__price small { font-size:11px; margin-top:1px; }
  .project-card__summary { font-size:15px; line-height:1.55; margin:14px 0 0; max-width:42ch; } .project-card__action { border-bottom:1px solid currentColor; flex:0 0 auto; font-size:13px; margin-bottom:3px; padding-bottom:3px; }
  @media(min-width:768px) and (max-width:1099px) { .project-card__info { align-items:start; display:block; } .project-card__price { border-left:0; border-top:1px solid var(--line); margin-top:14px; padding:12px 0 0; text-align:left; } .project-card--small .project-card__image { aspect-ratio:3/2; } }
  @media(max-width:767px) { .project-card__info { align-items:start; display:block; } .project-card__style { font-size:13px; } .project-card__meta { font-size:14px; } .project-card__summary { font-size:16px; } .project-card__action { font-size:14px; } .project-card__price { border-left:0; border-top:1px solid var(--line); font-size:13px; margin-top:16px; padding:12px 0 0; text-align:left; } .project-card__price strong { font-size:16px; } .project-card__price small { font-size:13px; } .project-card--small .project-card__image { aspect-ratio:3/2; } }
</style>

