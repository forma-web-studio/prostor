---
import PanoramaSurface from './PanoramaSurface.astro';
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
interface Props { projectSlug: string; poster: ImageMetadata; }
const { projectSlug, poster } = Astro.props;
---

<figure class="case-panorama" data-panorama data-project-hero={projectSlug}>
  <Image class="case-panorama__transition-poster" src={poster} alt="" width={1536} widths={[640,960,1200,1536]} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1099px) 90.6vw, (min-width: 1600px) 1536px, min(1320px, 100vw - 120px)" loading="eager" aria-hidden="true" />
  <PanoramaSurface id="case-panorama" label="Бесконечная панорама общей комнаты проекта Дом у сада" alt="Цилиндрическая панорама общей комнаты дома с садом, камином, мягкой зоной, столовой и кухней" variant="case" />
  <figcaption>
    <span>Общая комната · от мягкой зоны к кухне</span>
    <span class="case-panorama__range" aria-hidden="true"><i data-panorama-progress></i></span>
  </figcaption>
</figure>

<script src="../scripts/panorama.ts"></script>

<style>
  .case-panorama { margin:var(--space-6) 0 0; position:relative; }
  .case-panorama__transition-poster { height:clamp(380px,35vw,480px); inset:0 0 auto; object-fit:cover; opacity:0; pointer-events:none; position:absolute; width:100%; z-index:5; }
  :global(.project-transition-active) .case-panorama__transition-poster { opacity:1; }
  figcaption { align-items:center; color:var(--muted); display:flex; font-size:var(--text-sm); gap:var(--space-3); justify-content:space-between; margin-top:10px; }
  .case-panorama__range { background:var(--line); display:block; flex:0 0 120px; height:1px; position:relative; }
  .case-panorama__range i { background:var(--ink); border-radius:50%; height:7px; left:var(--pan-progress,12%); position:absolute; top:50%; transform:translate(-50%,-50%); width:7px; }
  @media (min-width:768px) and (max-width:1099px) { .case-panorama__transition-poster { height:clamp(360px,52vw,460px); } }
  @media (min-width:1600px) { .case-panorama__transition-poster { height:clamp(480px,29vw,560px); } }
  @media (max-width:767px) { .case-panorama { margin-top:var(--space-5); } .case-panorama__transition-poster { height:min(94vw,380px); } figcaption { align-items:flex-start; flex-direction:column; gap:10px; } .case-panorama__range { flex-basis:auto; width:100%; } }
  @media (orientation:landscape) and (max-height:520px) and (max-width:932px) { .case-panorama__transition-poster { height:clamp(220px,68svh,320px); } }
</style>
