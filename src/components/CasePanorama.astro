---
import PanoramaSurface from './PanoramaSurface.astro';
---

<figure class="case-panorama" data-panorama>
  <PanoramaSurface id="case-panorama" label="Бесконечная панорама общей комнаты проекта Дом у сада" alt="Цилиндрическая панорама общей комнаты дома с садом, камином, мягкой зоной, столовой и кухней" variant="case" />
  <figcaption>
    <span>Общая комната · от мягкой зоны к кухне</span>
    <span class="case-panorama__range" aria-hidden="true"><i data-panorama-progress></i></span>
  </figcaption>
</figure>

<script src="../scripts/panorama.ts"></script>

<style>
  .case-panorama { margin:var(--space-6) 0 0; }
  figcaption { align-items:center; color:var(--muted); display:flex; font-size:var(--text-sm); gap:var(--space-3); justify-content:space-between; margin-top:10px; }
  .case-panorama__range { background:var(--line); display:block; flex:0 0 120px; height:1px; position:relative; }
  .case-panorama__range i { background:var(--ink); border-radius:50%; height:7px; left:var(--pan-progress,12%); position:absolute; top:50%; transform:translate(-50%,-50%); width:7px; }
  @media (max-width:767px) { .case-panorama { margin-top:var(--space-5); } figcaption { align-items:flex-start; flex-direction:column; gap:10px; } .case-panorama__range { flex-basis:auto; width:100%; } }
</style>
