---
import { Image } from 'astro:assets';
import type { ProjectEvidence } from '../data/projects';

interface Props { evidence: ProjectEvidence; index: number; reverse?: boolean; }
const { evidence, index, reverse = false } = Astro.props;
---

<article class:list={['case-evidence', `case-evidence--${evidence.image.framing ?? 'landscape'}`, { 'case-evidence--reverse':reverse }]}>
  <div class="case-evidence__copy">
    <p class="eyebrow">Разбор {String(index).padStart(2,'0')} · {evidence.label}</p>
    <h3>{evidence.title}</h3>
    <p>{evidence.text}</p>
  </div>
  <figure>
    <div class="case-evidence__image" style={`--image-position:${evidence.image.position ?? 'center'};`}>
      <Image src={evidence.image.src} alt={evidence.image.alt} width={1200} quality={72} widths={[480,720,960,1200]} sizes="(max-width: 767px) calc(100vw - 40px), (min-width: 1440px) 748px, 55vw" loading="lazy" />
      {evidence.hotspots && <div class="case-evidence__hotspots" aria-label="Примечания к изображению">
        {evidence.hotspots.map((hotspot, hotspotIndex) => <details style={`--hotspot-x:${hotspot.x}%;--hotspot-y:${hotspot.y}%`} class:list={{ 'is-right':hotspot.x > 55 }}>
          <summary><span aria-hidden="true">{hotspotIndex + 1}</span><span class="sr-only">{hotspot.title}</span></summary>
          <div><strong>{hotspot.title}</strong><p>{hotspot.text}</p></div>
        </details>)}
      </div>}
    </div>
    <figcaption>{evidence.image.caption}</figcaption>
  </figure>
</article>

<style>
  .case-evidence { align-items:center; border-top:1px solid var(--line); display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); padding:var(--space-7) 0; }
  .case-evidence__copy { grid-column:1 / span 4; } figure { grid-column:6 / span 7; margin:0; }
  .case-evidence--reverse .case-evidence__copy { grid-column:9 / span 4; } .case-evidence--reverse figure { grid-column:1 / span 7; grid-row:1; }
  h3 { font-family:var(--font-display); font-size:clamp(2rem,3.5vw,3.25rem); font-weight:400; letter-spacing:-.03em; line-height:1.12; margin:var(--space-3) 0 var(--space-4); text-wrap:balance; }
  .case-evidence__copy > p:last-child { color:var(--muted); line-height:1.7; margin:0; max-width:34ch; }
  .case-evidence__image { aspect-ratio:3/2; overflow:hidden; position:relative; } .case-evidence__image :global(img) { height:100%; object-fit:cover; object-position:var(--image-position); width:100%; }
  .case-evidence--portrait figure { grid-column:7 / span 5; } .case-evidence--portrait.case-evidence--reverse figure { grid-column:1 / span 5; }
  .case-evidence--portrait .case-evidence__image { aspect-ratio:4/5; }
  .case-evidence--macro .case-evidence__image { aspect-ratio:16/9; }
  .case-evidence--macro .case-evidence__image :global(img) { transform:scale(1.6); transform-origin:var(--image-position); }
  figcaption { color:var(--muted); font-size:var(--text-xs); margin-top:10px; }
  .case-evidence__hotspots { inset:0; pointer-events:none; position:absolute; }
  details { left:var(--hotspot-x); pointer-events:auto; position:absolute; top:var(--hotspot-y); z-index:3; }
  summary { align-items:center; background:var(--surface); border:1px solid rgba(37,40,36,.5); border-radius:50%; box-shadow:0 4px 16px rgba(37,40,36,.16); cursor:pointer; display:flex; height:44px; justify-content:center; list-style:none; transform:translate(-50%,-50%); width:44px; }
  summary::-webkit-details-marker { display:none; } summary::marker { content:""; } summary:hover { background:var(--ink); color:var(--surface); } details[open] summary { background:var(--ink); color:var(--surface); }
  details > div { background:var(--surface); box-shadow:var(--shadow-raised); left:24px; padding:14px 16px; position:absolute; top:24px; width:min(240px,48vw); }
  details.is-right > div { left:auto; right:24px; }
  details strong { display:block; font-size:var(--text-sm); } details p { color:var(--muted); font-size:var(--text-xs); line-height:1.5; margin:6px 0 0; }
  @media(max-width:767px) {
    .case-evidence,.case-evidence--reverse { display:flex; flex-direction:column; gap:var(--space-5); padding:var(--space-6) 0; }
    .case-evidence__copy,figure,.case-evidence--reverse .case-evidence__copy,.case-evidence--reverse figure { width:100%; }
    .case-evidence__image,.case-evidence--portrait .case-evidence__image,.case-evidence--macro .case-evidence__image { aspect-ratio:auto; overflow:visible; }
    .case-evidence__image :global(picture) { aspect-ratio:4/3; display:block; overflow:hidden; }
    .case-evidence--portrait .case-evidence__image :global(picture) { aspect-ratio:4/5; }
    .case-evidence--macro .case-evidence__image :global(picture) { aspect-ratio:16/10; }
    .case-evidence--macro .case-evidence__image { overflow:hidden; }
    .case-evidence__hotspots { display:grid; gap:var(--space-2); inset:auto; margin-top:var(--space-3); position:relative; }
    details,details.is-right { border-top:1px solid var(--line); left:auto; padding-top:var(--space-2); position:relative; top:auto; }
    summary { border:0; border-radius:0; box-shadow:none; height:44px; justify-content:flex-start; transform:none; width:100%; }
    summary span:first-child { align-items:center; border:1px solid var(--ink); border-radius:50%; display:flex; height:30px; justify-content:center; width:30px; }
    details > div,details.is-right > div { background:transparent; box-shadow:none; left:auto; padding:0 0 var(--space-3) 42px; position:relative; right:auto; top:auto; width:auto; }
  }
</style>
