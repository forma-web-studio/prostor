---
import { navigation, site, contacts } from '../data/site';
import { withBase } from '../utils/urls';
---
<footer class="footer">
  <div class="container footer__grid">
    <a class="logo" href={withBase('/')}>ПРОСТОР</a>
    <nav aria-label="Навигация в подвале">{navigation.map((item) => <a href={withBase(item.href)}>{item.label}</a>)}</nav>
    <div class="details"><p>{site.tagline}</p><p>{contacts.address}<br />{contacts.hours}</p><a href={withBase('/privacy/')}>Конфиденциальность</a></div>
  </div>
</footer>
<style>
  .footer { border-top:1px solid var(--line); margin-top:0; padding:32px 0 40px; }
  .footer__grid { align-items:start; display:grid; gap:24px; grid-template-columns:1fr 1fr 1fr; }
  .logo { font-size:17px; font-weight:700; letter-spacing:.15em; text-decoration:none; }
  nav { display:flex; flex-wrap:wrap; gap:4px 24px; } nav a { align-items:center;color:var(--muted);display:inline-flex;font-size:14px;min-height:44px } .details { color:var(--muted);font-size:13px;text-align:right; } p { margin:0 0 8px; } .details a { color:inherit; }
  @media (max-width:767px) { .footer__grid { grid-template-columns:1fr; } .details { text-align:left; } }
</style>
