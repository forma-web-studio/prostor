---
import { studioProcess } from '../data/site';

interface Props { steps?: typeof studioProcess; }
const { steps = studioProcess } = Astro.props;
---
<ol class="process">{steps.map(({ number, title, text }) => <li><span>{number}</span><h3>{title}</h3><p>{text}</p></li>)}</ol>
<style>
  .process { border-top:1px solid var(--line); display:grid; gap:var(--grid-gap); grid-template-columns:repeat(4,minmax(0,1fr)); list-style:none; margin:var(--space-5) 0 0; padding:var(--space-3) 0 0; }
  li { min-width:0; padding-top:var(--space-1); } span { color:var(--accent-ink); font-size:var(--text-xs); font-weight:700; }
  h3 { font-family:var(--font-display); font-size:clamp(1.3rem,2vw,1.7rem); font-weight:400; line-height:1.25; margin:var(--space-4) 0 var(--space-2); }
  p { color:var(--muted); font-size:var(--text-sm); line-height:1.65; margin:0; }
  @media(max-width:767px) { .process { display:block; padding-top:0; } li { border-bottom:1px solid var(--line); padding:var(--space-4) 0; } li:last-child { border-bottom:0; } h3 { margin:var(--space-2) 0; } }
</style>
