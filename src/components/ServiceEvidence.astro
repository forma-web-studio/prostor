---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ArrowIcon from './ArrowIcon.astro';

interface Props {
  href:string;
  label:string;
  title:string;
  text:string;
  projectTitle:string;
  image:ImageMetadata;
  alt:string;
  reverse?:boolean;
}

const { href,label,title,text,projectTitle,image,alt,reverse = false } = Astro.props;
---
<article class:list={['service-evidence',{ 'service-evidence--reverse':reverse }]}>
  <div class="service-evidence__copy">
    <p class="eyebrow">{label}</p>
    <h3>{title}</h3>
    <p>{text}</p>
    <a class="inline-link" href={href}>Смотреть кейс «{projectTitle}» <ArrowIcon /></a>
  </div>
  <figure>
    <div class="service-evidence__media">
      <Image src={image} alt={alt} width={1200} quality={72} widths={[480,560,640,720,800,960,1200]} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1099px) 52vw, (min-width: 1600px) 880px, (min-width: 1440px) 760px, 55vw" loading="lazy" />
    </div>
  </figure>
</article>

<style>
  .service-evidence { align-items:center; border-top:1px solid var(--line); display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); padding:var(--space-7) 0; }
  .service-evidence__copy { grid-column:1 / span 4; }
  figure { grid-column:6 / span 7; margin:0; }
  .service-evidence--reverse .service-evidence__copy { grid-column:9 / span 4; }
  .service-evidence--reverse figure { grid-column:1 / span 7; grid-row:1; }
  h3 { font-family:var(--font-display); font-size:clamp(1.9rem,3vw,2.8rem); font-weight:400; letter-spacing:-.025em; line-height:1.12; margin:var(--space-2) 0 var(--space-3); }
  .service-evidence__copy > p:not(.eyebrow) { color:var(--muted); line-height:1.7; margin:0 0 var(--space-4); max-width:36ch; }
  .service-evidence__media { aspect-ratio:3/2; overflow:hidden; }
  .service-evidence__media :global(img) { height:100%; object-fit:cover; width:100%; }
  @media(min-width:768px) and (max-width:1099px){ .service-evidence__copy { grid-column:1 / span 5; } figure { grid-column:6 / span 7; } .service-evidence--reverse .service-evidence__copy { grid-column:8 / span 5; } .service-evidence--reverse figure { grid-column:1 / span 7; } }
  @media(max-width:767px){
    .service-evidence,.service-evidence--reverse { display:flex; flex-direction:column; gap:var(--space-5); padding:var(--space-6) 0; }
    .service-evidence__copy,figure,.service-evidence--reverse .service-evidence__copy,.service-evidence--reverse figure { width:100%; }
    .service-evidence__copy { order:0; }
    figure { order:1; }
    .service-evidence__media { aspect-ratio:4/3; }
  }
</style>
