---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { ProjectPlanToSpace } from '../data/projects';

interface Props {
  data: ProjectPlanToSpace;
  image: ImageMetadata;
  imageAlt: string;
}

const { data, image, imageAlt } = Astro.props;
const titleId = 'plan-to-space-title';
const firstDecision = data.decisions[0];
---

<section class="plan-to-space" aria-labelledby={titleId} data-plan-to-space data-active={firstDecision.id}>
  <header class="plan-to-space__intro">
    <p class="eyebrow">Схема сценария</p>
    <div>
      <h2 id={titleId}>{data.title}</h2>
      <p>{data.intro}</p>
    </div>
  </header>

  <div class="plan-to-space__experience">
    <div class="plan-to-space__legend" aria-hidden="true">
      <span>Схема</span>
      <span>Пространство</span>
    </div>

    <div class="plan-to-space__comparison" data-comparison style="--split: 50%;">
      <div class="plan-to-space__layer plan-to-space__layer--scheme" data-layer>
        <svg viewBox="0 0 960 600" role="img" aria-label="Схема сценария общей комнаты со столом у окна, проходом и закрытым хранением">
          <rect class="scheme__room" x="36" y="36" width="888" height="528" rx="2" />
          <path class="scheme__window" d="M118 36v24m58-24v24m58-24v24m58-24v24m58-24v24m58-24v24" />
          <text class="scheme__label scheme__label--window" x="264" y="92" text-anchor="middle">свет из окна</text>
          <g data-zone="table">
            <rect class="scheme__table" x="174" y="150" width="292" height="128" rx="64" />
            <circle class="scheme__chair" cx="230" cy="126" r="18" />
            <circle class="scheme__chair" cx="410" cy="126" r="18" />
            <circle class="scheme__chair" cx="230" cy="302" r="18" />
            <circle class="scheme__chair" cx="410" cy="302" r="18" />
            <text class="scheme__label" x="320" y="210" text-anchor="middle">общий стол</text>
            <text class="scheme__sub" x="320" y="234" text-anchor="middle">работа днём · ужин вечером</text>
          </g>
          <g data-zone="storage">
            <rect class="scheme__storage" x="760" y="112" width="112" height="360" rx="3" />
            <path class="scheme__storage-lines" d="M797 112v360m38-360v360" />
            <text class="scheme__label" x="816" y="500" text-anchor="middle">хранение</text>
          </g>
          <path class="scheme__route" d="M118 430C270 360 454 370 688 430" />
          <path class="scheme__route-arrow" d="m672 414 22 18-27 9" />
          <text class="scheme__label" x="384" y="462" text-anchor="middle">свободный проход</text>
          <text class="scheme__room-label" x="92" y="526">общая комната</text>
        </svg>
      </div>

      <div class="plan-to-space__layer plan-to-space__layer--space" data-layer>
        <Image
          src={image}
          alt={imageAlt}
          width={1320}
          quality={72}
          widths={[640, 960, 1320, 1920]}
          sizes="(max-width: 767px) calc(100vw - 40px), min(1320px, 100vw - 120px)"
          loading="lazy"
        />
        <span class="plan-to-space__callout plan-to-space__callout--table" data-callout="table">Стол у окна</span>
        <span class="plan-to-space__callout plan-to-space__callout--storage" data-callout="storage">Закрытое хранение</span>
      </div>

      <div class="plan-to-space__divider" aria-hidden="true"></div>
      <button
        class="plan-to-space__handle"
        type="button"
        role="slider"
        aria-label="Сравнение схемы сценария и пространства"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        aria-valuetext="Поровну: схема и пространство"
        aria-orientation="horizontal"
        data-handle
        hidden
      ><span aria-hidden="true">↔</span></button>
    </div>

    <div class="plan-to-space__presets" role="group" aria-label="Положение сравнения" data-presets hidden>
      <button type="button" data-value="0" aria-label="0 процентов схемы — только пространство">Пространство</button>
      <button type="button" data-value="50" aria-label="50 процентов схемы — поровну" aria-pressed="true">Поровну</button>
      <button type="button" data-value="100" aria-label="100 процентов схемы — только схема">Схема</button>
    </div>

    <p class="plan-to-space__caption">{data.caption}</p>
  </div>

  <div class="plan-to-space__decisions">
    <div class="plan-to-space__tabs" role="group" aria-label="Разобрать решение" data-decision-tabs hidden>
      {data.decisions.map((decision, index) => (
        <button type="button" data-decision={decision.id} aria-pressed={index === 0 ? 'true' : 'false'}>{decision.label}</button>
      ))}
    </div>
    <div class="plan-to-space__decision-copy" data-decision-copy aria-live="polite">
      {data.decisions.map((decision) => (
        <article data-decision-panel={decision.id}>
          <h3>{decision.title}</h3>
          <p>{decision.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<script>
  import { initPlanToSpace } from '../scripts/plan-to-space';
  document.querySelectorAll<HTMLElement>('[data-plan-to-space]').forEach(initPlanToSpace);
</script>

<style>
  .plan-to-space { border-top:1px solid var(--line); margin-top:var(--space-7); padding-top:var(--space-5); }
  .plan-to-space__intro { display:grid; gap:var(--grid-gap); grid-template-columns:repeat(12,minmax(0,1fr)); }
  .plan-to-space__intro > .eyebrow { grid-column:1 / span 3; padding-top:10px; }
  .plan-to-space__intro > div { grid-column:4 / span 7; }
  h2,h3 { font-family:var(--font-display); font-weight:400; letter-spacing:-.03em; text-wrap:balance; }
  h2 { font-size:clamp(2rem,4vw,3.625rem); line-height:1.1; margin:0; max-width:16ch; }
  .plan-to-space__intro div > p { color:var(--muted); font-size:var(--text-sm); line-height:1.7; margin:var(--space-3) 0 0; max-width:62ch; }
  .plan-to-space__experience { margin-top:var(--space-6); }
  .plan-to-space__legend { display:flex; font-size:var(--text-xs); font-weight:600; justify-content:space-between; letter-spacing:.08em; margin-bottom:var(--space-2); padding-inline:1px 3px; text-transform:uppercase; }
  .plan-to-space__comparison { display:grid; gap:var(--space-3); grid-template-columns:1fr 1fr; }
  .plan-to-space__layer { aspect-ratio:16 / 10; min-width:0; overflow:hidden; position:relative; }
  .plan-to-space__layer--scheme { background:var(--surface-muted); color:var(--ink); padding:clamp(14px,2vw,28px); }
  .plan-to-space__layer--space :global(picture),.plan-to-space__layer--space :global(img) { height:100%; width:100%; }
  .plan-to-space__layer--space :global(img) { object-fit:cover; object-position:center; }
  .plan-to-space__layer--scheme svg { display:block; height:100%; width:100%; }
  .scheme__room { fill:var(--surface); stroke:currentColor; stroke-width:3; }
  .scheme__window,.scheme__storage-lines { fill:none; stroke:var(--accent-ink); stroke-width:4; }
  .scheme__table,.scheme__chair,.scheme__storage { fill:#e1ddd2; stroke:currentColor; stroke-width:3; transition:fill var(--duration-ui) var(--ease-ui),stroke var(--duration-ui) var(--ease-ui); }
  .scheme__route,.scheme__route-arrow { fill:none; stroke:var(--muted); stroke-dasharray:10 10; stroke-width:3; }
  .scheme__route-arrow { stroke-dasharray:none; }
  .scheme__label,.scheme__room-label { fill:var(--ink); font-family:var(--font-body); font-size:18px; font-weight:600; letter-spacing:.02em; }
  .scheme__sub,.scheme__label--window { fill:var(--muted); font-family:var(--font-body); font-size:14px; }
  .scheme__room-label { font-size:15px; letter-spacing:.08em; text-transform:uppercase; }
  .plan-to-space__callout { background:rgba(250,248,243,.92); border:1px solid rgba(37,40,36,.2); color:var(--ink); font-size:var(--text-xs); font-weight:600; left:22%; padding:8px 10px; position:absolute; top:58%; }
  .plan-to-space__callout--storage { left:auto; right:8%; top:34%; }
  .plan-to-space__divider,.plan-to-space__handle { display:none; }
  .plan-to-space__presets,.plan-to-space__tabs { display:flex; flex-wrap:wrap; gap:var(--space-1); }
  .plan-to-space__presets { justify-content:center; margin-top:var(--space-3); }
  .plan-to-space__presets button,.plan-to-space__tabs button { background:transparent; border:1px solid var(--control-line); min-height:var(--control-height-compact); padding:9px 15px; }
  .plan-to-space__presets button[aria-pressed="true"],.plan-to-space__tabs button[aria-pressed="true"] { background:var(--ink); border-color:var(--ink); color:var(--surface); }
  .plan-to-space__caption { color:var(--muted); font-size:var(--text-xs); margin:var(--space-2) 0 0; }
  .plan-to-space__decisions { display:grid; gap:var(--grid-gap); grid-template-columns:4fr 8fr; margin-top:var(--space-5); }
  .plan-to-space__decision-copy { min-height:126px; }
  .plan-to-space__decision-copy article + article { border-top:1px solid var(--line); margin-top:var(--space-4); padding-top:var(--space-4); }
  .plan-to-space__decision-copy h3 { font-size:clamp(1.65rem,2.5vw,2.35rem); line-height:1.2; margin:0; }
  .plan-to-space__decision-copy p { color:var(--muted); line-height:1.7; margin:var(--space-2) 0 0; max-width:62ch; }

  .plan-to-space.is-ready .plan-to-space__comparison { aspect-ratio:16 / 10; display:block; overflow:hidden; position:relative; touch-action:pan-y; user-select:none; }
  .plan-to-space.is-ready .plan-to-space__layer { inset:0; position:absolute; }
  .plan-to-space.is-ready .plan-to-space__layer--scheme { clip-path:inset(0 calc(100% - var(--split)) 0 0); z-index:2; }
  .plan-to-space.is-ready .plan-to-space__layer--space { z-index:1; }
  .plan-to-space.is-ready .plan-to-space__divider { background:var(--surface); box-shadow:0 0 0 1px rgba(37,40,36,.24); display:block; height:100%; left:var(--split); position:absolute; top:0; transform:translateX(-1px); width:2px; z-index:3; }
  .plan-to-space.is-ready .plan-to-space__handle { align-items:center; background:var(--surface); border:1px solid var(--ink); border-radius:50%; box-shadow:var(--shadow-control); display:flex; height:48px; justify-content:center; left:var(--split); padding:0; position:absolute; top:50%; transform:translate(-50%,-50%); width:48px; z-index:4; }
  .plan-to-space.is-ready .plan-to-space__handle:active { box-shadow:var(--shadow-control-pressed); }
  .plan-to-space.is-ready .plan-to-space__handle span { font-size:20px; line-height:1; transform:translateY(-1px); }
  .plan-to-space.is-ready[data-active="table"] [data-zone="table"] :is(.scheme__table,.scheme__chair),
  .plan-to-space.is-ready[data-active="storage"] [data-zone="storage"] .scheme__storage { fill:#b8b49f; stroke:var(--accent-ink); }
  .plan-to-space.is-ready [data-callout] { opacity:.28; }
  .plan-to-space.is-ready[data-active="table"] [data-callout="table"],
  .plan-to-space.is-ready[data-active="storage"] [data-callout="storage"] { opacity:1; }

  @media(max-width:767px) {
    .plan-to-space { margin-top:var(--space-6); padding-top:var(--space-4); }
    .plan-to-space__intro { display:block; }
    .plan-to-space__intro > .eyebrow { padding:0; }
    h2 { font-size:2.125rem; margin-top:var(--space-2); }
    .plan-to-space__experience { margin-top:var(--space-5); }
    .plan-to-space__comparison { grid-template-columns:1fr; }
    .plan-to-space__layer { aspect-ratio:4 / 3; }
    .plan-to-space.is-ready .plan-to-space__comparison { aspect-ratio:4 / 3; }
    .plan-to-space__layer--scheme { padding:12px; }
    .scheme__label { font-size:30px; }
    .scheme__room-label { font-size:27px; }
    .scheme__sub,.scheme__label--window { font-size:22px; }
    .plan-to-space__callout { padding:6px 8px; }
    .plan-to-space__presets { display:grid; grid-template-columns:repeat(3,1fr); }
    .plan-to-space__presets button { padding-inline:8px; }
    .plan-to-space__decisions { display:block; margin-top:var(--space-4); }
    .plan-to-space__tabs { display:grid; grid-template-columns:1fr 1fr; }
    .plan-to-space__decision-copy { margin-top:var(--space-4); min-height:0; }
  }

  @media(prefers-reduced-motion:reduce) {
    .scheme__table,.scheme__chair,.scheme__storage,.plan-to-space__callout { transition:none; }
  }
</style>
