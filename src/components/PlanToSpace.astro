---
import { Image } from 'astro:assets';
import type { ProjectPlanToSpace } from '../data/projects';

interface Props { data: ProjectPlanToSpace; }

const { data } = Astro.props;
const titleId = 'plan-to-space-title';
---

<section class="plan-to-space" aria-labelledby={titleId} data-plan-to-space>
  <header class="plan-to-space__intro">
    <p class="eyebrow">Сопоставление</p>
    <div>
      <h2 id={titleId}>{data.title}</h2>
      <p>{data.intro}</p>
    </div>
  </header>

  <div class="plan-to-space__experience">
    <div class="plan-to-space__legend" aria-hidden="true">
      <span>План</span>
      <span>Вид сверху</span>
    </div>

    <div class="plan-to-space__comparison" data-comparison style="--split: 50%;">
      <div class="plan-to-space__layer plan-to-space__layer--plan" data-layer>
        <img src={data.plan} alt={data.planAlt} width="1536" height="1024" loading="lazy" />
      </div>

      <div class="plan-to-space__layer plan-to-space__layer--space" data-layer>
        <Image
          src={data.image}
          alt={data.imageAlt}
          width={1536}
          quality={82}
          widths={[640, 768, 960, 1120, 1280, 1536]}
          sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1099px) 94.3vw, min(1320px, 100vw - 120px)"
          loading="lazy"
        />
      </div>

      <div class="plan-to-space__divider" aria-hidden="true"></div>
      <button
        class="plan-to-space__handle"
        type="button"
        role="slider"
        aria-label="Сравнение плана и вида комнаты сверху"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="50"
        aria-valuetext="Поровну: план и вид сверху"
        aria-orientation="horizontal"
        data-handle
        hidden
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 12h16M8 8l-4 4 4 4M16 8l4 4-4 4" />
        </svg>
      </button>
    </div>

    <div class="plan-to-space__presets" role="group" aria-label="Положение сравнения" data-presets hidden>
      <button type="button" data-value="0" aria-label="Только вид комнаты сверху">Вид сверху</button>
      <button type="button" data-value="50" aria-label="План и вид сверху поровну" aria-pressed="true">50 / 50</button>
      <button type="button" data-value="100" aria-label="Только план">План</button>
    </div>

    <p class="plan-to-space__caption">{data.caption}</p>
  </div>
</section>

<script>
  import { initPlanToSpace } from '../scripts/plan-to-space';
  document.querySelectorAll<HTMLElement>('[data-plan-to-space]').forEach(initPlanToSpace);
</script>

<style>
  .plan-to-space {
    border-top:1px solid var(--line);
    margin-top:var(--space-7);
    padding-top:var(--space-5);
  }
  .plan-to-space__intro {
    display:grid;
    gap:var(--grid-gap);
    grid-template-columns:repeat(12,minmax(0,1fr));
  }
  .plan-to-space__intro > .eyebrow {
    grid-column:1 / span 3;
    padding-top:10px;
  }
  .plan-to-space__intro > div { grid-column:4 / span 7; }
  h2 {
    font-family:var(--font-display);
    font-size:clamp(2rem,4vw,3.625rem);
    font-weight:400;
    letter-spacing:-.03em;
    line-height:1.1;
    margin:0;
    text-wrap:balance;
  }
  .plan-to-space__intro div > p {
    color:var(--muted);
    font-size:var(--text-sm);
    line-height:1.7;
    margin:var(--space-2) 0 0;
    max-width:52ch;
  }
  .plan-to-space__experience { margin-top:var(--space-5); }
  .plan-to-space__legend {
    display:flex;
    font-size:var(--text-xs);
    font-weight:600;
    justify-content:space-between;
    letter-spacing:.08em;
    margin-bottom:var(--space-2);
    text-transform:uppercase;
  }
  .plan-to-space__comparison {
    display:grid;
    gap:var(--space-3);
    grid-template-columns:1fr 1fr;
  }
  .plan-to-space__layer {
    aspect-ratio:8 / 5;
    background:#eeebe3;
    min-width:0;
    overflow:hidden;
    position:relative;
  }
  .plan-to-space__layer :global(picture),
  .plan-to-space__layer :global(img) {
    display:block;
    height:100%;
    width:100%;
  }
  .plan-to-space__layer :global(img) {
    object-fit:cover;
    transform:scale(1.04);
    transform-origin:center;
  }
  .plan-to-space__divider,.plan-to-space__handle { display:none; }
  .plan-to-space__presets {
    display:flex;
    gap:0;
    justify-content:center;
    margin-top:var(--space-3);
  }
  .plan-to-space__presets button {
    background:transparent;
    border:1px solid var(--control-line);
    min-height:44px;
    padding:9px 16px;
  }
  .plan-to-space__presets button + button { margin-left:-1px; }
  .plan-to-space__presets button[aria-pressed="true"] {
    background:var(--ink);
    border-color:var(--ink);
    color:var(--surface);
    position:relative;
  }
  .plan-to-space__caption {
    color:var(--muted);
    font-size:var(--text-xs);
    margin:var(--space-2) 0 0;
    text-align:center;
  }

  .plan-to-space.is-ready .plan-to-space__comparison {
    aspect-ratio:8 / 5;
    display:block;
    overflow:hidden;
    position:relative;
    touch-action:pan-y;
    user-select:none;
  }
  .plan-to-space.is-ready .plan-to-space__layer {
    inset:0;
    position:absolute;
  }
  .plan-to-space.is-ready .plan-to-space__layer--plan {
    clip-path:inset(0 calc(100% - var(--split)) 0 0);
    z-index:2;
  }
  .plan-to-space.is-ready .plan-to-space__layer--space { z-index:1; }
  .plan-to-space.is-ready .plan-to-space__divider {
    background:var(--surface);
    box-shadow:0 0 0 1px rgba(37,40,36,.28);
    display:block;
    height:100%;
    left:var(--split);
    position:absolute;
    top:0;
    transform:translateX(-1px);
    width:2px;
    z-index:3;
  }
  .plan-to-space.is-ready .plan-to-space__handle {
    align-items:center;
    background:var(--surface);
    border:1px solid var(--ink);
    border-radius:50%;
    box-shadow:var(--shadow-control);
    display:flex;
    height:48px;
    justify-content:center;
    left:clamp(30px,var(--split),calc(100% - 30px));
    padding:0;
    position:absolute;
    top:50%;
    transform:translate(-50%,-50%);
    width:48px;
    z-index:4;
  }
  .plan-to-space.is-ready .plan-to-space__handle:active { box-shadow:var(--shadow-control-pressed); }
  .plan-to-space__handle svg {
    fill:none;
    height:22px;
    stroke:currentColor;
    stroke-linecap:square;
    stroke-linejoin:miter;
    stroke-width:1.5;
    width:22px;
  }

  @media(max-width:767px) {
    .plan-to-space { margin-top:var(--space-6); padding-top:var(--space-4); }
    .plan-to-space__intro { display:block; }
    .plan-to-space__intro > .eyebrow { padding:0; }
    h2 { font-size:2.125rem; margin-top:var(--space-2); }
    .plan-to-space__experience { margin-top:var(--space-4); }
    .plan-to-space__comparison { grid-template-columns:1fr; }
    .plan-to-space__presets { display:grid; grid-template-columns:repeat(3,1fr); }
    .plan-to-space__presets button { padding-inline:8px; }
    .plan-to-space__caption { line-height:1.55; text-align:left; }
  }

  @media(prefers-reduced-motion:reduce) {
    .plan-to-space__divider,.plan-to-space__handle { transition:none; }
  }
</style>
