---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import PanoramaHero from '../components/PanoramaHero.astro';
import ProjectCard from '../components/ProjectCard.astro';
import EvidenceRow from '../components/EvidenceRow.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import ArrowIcon from '../components/ArrowIcon.astro';
import { featuredProjects, projects } from '../data/projects';
import { withBase } from '../utils/urls';

const lightProject = projects.find(({ slug }) => slug === 'svet-i-dub')!;
const cityProject = projects.find(({ slug }) => slug === 'tishina-goroda')!;

const serviceProof = [
  { number:'01', title:'Найти логику пространства', text:'Проверяем несколько сценариев планировки, чтобы движение, мебель и хранение работали до начала отделки.', result:'На руках: выбранная планировка с расстановкой мебели.' },
  { number:'02', title:'Увидеть интерьер целиком', text:'Связываем свет, материалы и детали в одну систему, которую можно обсудить до стройки.', result:'На руках: визуальная концепция и рабочая документация.' },
  { number:'03', title:'Сохранить замысел в реализации', text:'Собираем спецификации, согласуем замены и отвечаем на вопросы, которые возникают на объекте.', result:'На руках: ведомости и актуальные решения по проекту.' },
];
---

<BaseLayout title="ПРОСТОР — студия интерьерной архитектуры" description="Интерьеры квартир и загородных домов. Планировка, материалы и свет под ваш ритм жизни.">
  <PanoramaHero />

  <section class="projects container" id="projects" aria-labelledby="projects-title">
    <div class="section-title">
      <div><p class="eyebrow">Избранные проекты</p><h2 id="projects-title">Три пространства — три сценария жизни</h2></div>
      <a class="inline-link" href={withBase('/projects/')}>Все проекты <ArrowIcon /></a>
    </div>
    <div class="project-grid">
      <div class="project-grid__item project-grid__item--one"><ProjectCard project={featuredProjects[0]} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1099px) 44vw, (min-width: 1440px) 748px, 54vw" linked editorial /></div>
      <div class="project-grid__item project-grid__item--two"><ProjectCard project={featuredProjects[1]} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1099px) 44vw, (min-width: 1440px) 420px, 30vw" size="small" linked editorial /></div>
      <div class="project-grid__item project-grid__item--three"><ProjectCard project={featuredProjects[2]} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1099px) 90.6vw, (min-width: 1440px) 858px, 62vw" linked editorial /></div>
    </div>
  </section>

  <section class="evidence container" aria-labelledby="evidence-title">
    <header class="evidence__intro">
      <p class="eyebrow">Архитектура решений</p>
      <h2 id="evidence-title">Не образ сам по себе, а ответ на повседневную задачу</h2>
      <p>Показываем не только кадр, но и логику: что ограничивало пространство, какой приём мы выбрали и что изменилось в ежедневном сценарии.</p>
    </header>
    <EvidenceRow project={lightProject} index="01" />
    <EvidenceRow project={cityProject} index="02" reverse />
  </section>

  <section class="service-proof container" aria-labelledby="services-title">
    <div class="service-proof__heading">
      <div><p class="eyebrow">Что даёт проект</p><h2 id="services-title">От первого плана до решений на объекте</h2></div>
      <p>Состав работы зависит от задачи, но каждый этап заканчивается понятным материалом, который помогает принять следующее решение.</p>
    </div>
    <ol class="service-proof__list">
      {serviceProof.map(({ number, title, text, result }) => <li><span>{number}</span><h3>{title}</h3><p>{text}</p><strong>{result}</strong></li>)}
    </ol>
    <a class="inline-link service-proof__link" href={withBase('/services/')}>Посмотреть состав услуг <ArrowIcon /></a>
  </section>

  <section class="process-section container" aria-labelledby="process-title">
    <p class="eyebrow">Как строится работа</p>
    <h2 id="process-title">От разговора к комплекту для реализации</h2>
    <ProcessSteps />
  </section>

  <section class="cta container" id="contact">
    <div><p class="eyebrow">Первый разговор</p><h2>Начнём с вашей задачи</h2></div>
    <div><p>Расскажите о пространстве, привычках и сроках. На консультации определим подходящий состав проекта и ближайший шаг.</p><Button href={withBase('/contact/')}>Обсудить интерьер</Button></div>
  </section>
</BaseLayout>

<style>
  h1,h2 { font-family:var(--font-display); font-weight:400; letter-spacing:-.03em; text-wrap:balance; }
  .projects,.evidence,.service-proof,.process-section { padding-top:var(--section-space); }
  .section-title { align-items:end; display:flex; justify-content:space-between; margin-bottom:var(--space-6); }
  .section-title h2,.process-section h2 { font-size:var(--title-section); line-height:1.12; margin:var(--space-2) 0 0; max-width:18ch; }
  .section-title > a { flex:0 0 auto; font-size:var(--text-sm); margin-left:var(--space-5); padding-bottom:10px; white-space:nowrap; }
  .project-grid { display:grid; gap:var(--space-7) var(--space-4); grid-template-columns:var(--grid-columns); }
  .project-grid__item--one { grid-column:1 / span 7; }
  .project-grid__item--two { grid-column:9 / span 4; margin-top:84px; }
  .project-grid__item--three { grid-column:3 / span 8; }

  .evidence { margin-top:var(--section-space); }
  .evidence__intro { display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); padding-bottom:var(--space-7); }
  .evidence__intro .eyebrow { grid-column:1 / span 3; padding-top:10px; }
  .evidence__intro h2 { font-size:var(--title-section); grid-column:4 / span 6; line-height:1.14; margin:0; }
  .evidence__intro > p:last-child { color:var(--muted); grid-column:10 / span 3; line-height:1.65; margin:4px 0 0; }

  .service-proof { border-top:1px solid var(--line); margin-top:var(--section-space); }
  .service-proof__heading { display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); }
  .service-proof__heading > div { grid-column:1 / span 7; }
  .service-proof__heading h2 { font-size:var(--title-section); line-height:1.12; margin:var(--space-2) 0 0; max-width:18ch; }
  .service-proof__heading > p { color:var(--muted); grid-column:9 / span 4; line-height:1.65; margin:28px 0 0; }
  .service-proof__list { display:grid; gap:var(--grid-gap); grid-template-columns:repeat(3,minmax(0,1fr)); list-style:none; margin:var(--space-6) 0 0; padding:0; }
  .service-proof__list li { border-top:1px solid var(--line); display:flex; flex-direction:column; min-height:300px; padding-top:var(--space-3); }
  .service-proof__list span { color:var(--accent-ink); font-size:var(--text-xs); font-weight:700; }
  .service-proof__list h3 { font-family:var(--font-display); font-size:clamp(1.45rem,2.2vw,2rem); font-weight:400; line-height:1.2; margin:var(--space-4) 0 var(--space-3); max-width:15ch; }
  .service-proof__list p { color:var(--muted); font-size:var(--text-sm); line-height:1.65; margin:0; max-width:34ch; }
  .service-proof__list strong { border-top:1px solid var(--line); font-size:var(--text-sm); font-weight:600; line-height:1.5; margin-top:auto; padding-top:var(--space-3); }
  .service-proof__link { font-size:var(--text-sm); margin-top:var(--space-5); }

  .process-section { padding-bottom:var(--section-space); }
  .cta { align-items:start; border-top:1px solid var(--line); display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); padding-bottom:var(--section-space); padding-top:var(--space-7); }
  .cta > div:first-child { grid-column:1 / span 7; }
  .cta h2 { font-size:clamp(2.5rem,5vw,4rem); line-height:1.1; margin:var(--space-2) 0 0; max-width:12ch; }
  .cta > div:last-child { grid-column:9 / span 4; }
  .cta > div:last-child p { line-height:1.65; margin-top:0; }

  @media (min-width:768px) and (max-width:1099px) {
    .cta { display:block; } .cta > div:last-child { margin-top:28px; max-width:38ch; }
    .project-grid__item--one,.project-grid__item--two { grid-column:span 6; margin-top:0; } .project-grid__item--three { grid-column:1 / span 12; }
    .evidence__intro .eyebrow { grid-column:1 / span 3; } .evidence__intro h2 { grid-column:4 / span 9; } .evidence__intro > p:last-child { grid-column:4 / span 7; }
    .service-proof__heading > div { grid-column:1 / span 7; } .service-proof__heading > p { grid-column:8 / span 5; }
  }
  @media (max-width:767px) {
    .projects,.evidence,.service-proof,.process-section { padding-top:var(--space-7); }
    .section-title { align-items:start; display:block; margin-bottom:var(--space-5); } .section-title > a { display:inline-flex; margin:var(--space-3) 0 0; padding:0; }
    .project-grid { display:block; } .project-grid__item { margin:0 0 var(--space-6); } .project-grid__item:last-child { margin-bottom:0; }
    .evidence,.service-proof { margin-top:var(--space-7); }
    .evidence__intro,.service-proof__heading { display:block; padding-bottom:var(--space-3); }
    .evidence__intro .eyebrow { padding:0; } .evidence__intro h2,.service-proof__heading h2 { font-size:2.35rem; margin-top:var(--space-2); }
    .evidence__intro > p:last-child,.service-proof__heading > p { margin-top:var(--space-4); }
    .service-proof__list { display:block; margin-top:var(--space-5); }
    .service-proof__list li { min-height:0; padding:var(--space-4) 0; } .service-proof__list h3 { margin:var(--space-3) 0 var(--space-2); } .service-proof__list strong { margin-top:var(--space-4); }
    .process-section { padding-bottom:var(--space-7); }
    .cta { display:block; padding-bottom:var(--space-7); padding-top:var(--space-6); } .cta > div:last-child { margin-top:var(--space-5); }
  }
</style>
