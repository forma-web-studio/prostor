---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Button from '../../components/Button.astro'; import { services } from '../../data/services'; import { withBase } from '../../utils/urls'; export function getStaticPaths(){return services.map(service=>({params:{slug:service.slug},props:{service}}))};const {service}=Astro.props;
---
<BaseLayout title={`${service.title} — ПРОСТОР`} description={service.lead}><article class="service container"><a class="back" href={withBase('/services/')}>Услуги</a><p class="eyebrow">Услуга студии</p><h1>{service.title}</h1><p class="lead">{service.lead}</p><div class="facts"><p><b>В результате</b>{service.result}</p><p><b>Ориентировочный срок</b>{service.term}</p><p><b>Принцип цены</b>{service.price}</p></div><section><p class="eyebrow">В работе</p><ul>{service.includes.map(item=><li>{item}</li>)}</ul></section><section class="service__cta"><div><p class="eyebrow">Обсудить задачу</p><h2>Соберём подходящий состав работы</h2></div><Button href={withBase('/contact/')}>Записаться на консультацию</Button></section></article></BaseLayout>
<style>h1,h2{font-family:Prata,Georgia,serif;font-weight:400;letter-spacing:-.03em}.service{padding:32px 0 80px}.back{color:var(--muted);display:block;font-size:14px;margin-bottom:58px}.eyebrow{margin-top:0}h1{font-size:clamp(50px,7vw,84px);line-height:1.04;margin:12px 0 24px}.lead{font-size:20px;max-width:43ch}.facts{border-top:1px solid var(--line);display:grid;gap:24px;grid-template-columns:repeat(3,1fr);margin-top:64px;padding-top:22px}.facts p{color:var(--muted);font-size:15px;margin:0}.facts b{color:var(--ink);display:block;font-size:12px;letter-spacing:.06em;margin-bottom:8px;text-transform:uppercase}.service section:not(.service__cta){margin-top:72px}.service ul{font-size:20px;line-height:1.5;margin:18px 0;padding-left:22px}.service__cta{align-items:end;border-top:1px solid var(--line);display:flex;justify-content:space-between;margin-top:88px;padding-top:48px}.service__cta h2{font-size:clamp(34px,4vw,55px);line-height:1.1;margin:10px 0;max-width:12ch}@media(max-width:767px){.service{padding:24px 0 56px;min-width:0}.service h1{font-size:clamp(42px,11vw,54px);overflow-wrap:anywhere}.back{margin-bottom:38px}.lead{font-size:17px}.facts{grid-template-columns:1fr;margin-top:44px}.service section:not(.service__cta){margin-top:48px}.service__cta{display:block;margin-top:56px}.service__cta :global(.button){margin-top:22px;width:100%}}</style>
