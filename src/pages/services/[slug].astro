---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceDetail from '../../components/ServiceDetail.astro';
import { services,type Service } from '../../data/services';

export function getStaticPaths(){
  return services.map(service => ({ params:{ slug:service.slug },props:{ service } }));
}

const { service } = Astro.props as { service:Service };
---
<BaseLayout title={`${service.title} — ПРОСТОР`} description={`${service.lead} ${service.result}`}>
  <ServiceDetail service={service} />
</BaseLayout>
