---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Button from '../../components/Button.astro'; import ArrowIcon from '../../components/ArrowIcon.astro'; import ProjectCalculator from '../../components/ProjectCalculator.astro'; import { services } from '../../data/services'; import { withBase } from '../../utils/urls';
---
<BaseLayout title="Услуги — ПРОСТОР" description="Планировка, полный дизайн-проект и сопровождение реализации интерьера."><section class="services container"><p class="eyebrow">Услуги студии</p><h1>Работаем с пространством от первого плана до реализации</h1><div class="services__list">{services.map((s,i)=><a href={withBase(`/services/${s.slug}/`)}><span>0{i+1}</span><div><h2>{s.title}</h2><p>{s.lead}</p></div><small>{s.price} <ArrowIcon /></small></a>)}</div><ProjectCalculator /><section class="call"><div><p class="eyebrow">Первый разговор</p><h2>Начнём с вашей планировки</h2></div><Button href={withBase('/contact/')}>Обсудить проект</Button></section></section></BaseLayout>
<style>h1,h2{font-family:Prata,Georgia,serif;font-weight:400;letter-spacing:-.03em}h1{font-size:clamp(44px,5.5vw,76px);line-height:1.06;margin:14px 0 64px;max-width:14ch}.services{padding:72px 0}.services__list{border-top:1px solid var(--line)}.services__list a{align-items:start;border-bottom:1px solid var(--line);display:grid;gap:24px;grid-template-columns:70px 1fr auto;padding:27px 0;text-decoration:none}.services__list span,.services__list small{color:var(--muted);font-size:13px}.services__list h2{font-size:clamp(25px,2.4vw,34px);margin:0}.services__list p{margin:6px 0 0;max-width:45ch}.services__list small{align-items:center;display:flex;gap:18px}.services__list a:hover small :global(.icon-arrow),.services__list a:focus-visible small :global(.icon-arrow){transform:translateX(3px)}.calculator{margin-top:96px}.call{align-items:center;display:flex;justify-content:space-between;padding:72px 0 16px}.call h2{font-size:clamp(34px,4vw,56px);margin:10px 0}@media(max-width:767px){.services{padding:48px 0}.services__list a{grid-template-columns:34px 1fr}.services__list small{grid-column:2}.call{align-items:start;display:block;padding:56px 0 0}.call :global(.button){margin-top:24px;width:100%}}</style>
