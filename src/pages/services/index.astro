---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import ArrowIcon from '../../components/ArrowIcon.astro';
import ProjectCalculator from '../../components/ProjectCalculator.astro';
import ServiceEvidence from '../../components/ServiceEvidence.astro';
import { projects } from '../../data/projects';
import { serviceDeliverables,serviceEvidenceLinks,services } from '../../data/services';
import { sitePath } from '../../utils/urls';

const evidenceItems = serviceEvidenceLinks.map(item => {
  const project = projects.find(candidate => candidate.slug === item.projectSlug);
  if (!project) throw new Error(`Unknown service evidence project: ${item.projectSlug}`);
  const media = item.source === 'plan' && project.caseStudy.planToSpace
    ? { src:project.caseStudy.planToSpace.image,alt:project.caseStudy.planToSpace.imageAlt }
    : project.caseStudy.evidence['evidenceIndex' in item ? item.evidenceIndex : 0].image;
  return { ...item,project,image:media.src,alt:media.alt };
});
---
<BaseLayout title="Услуги — ПРОСТОР" description="Планировка, полный дизайн-проект и сопровождение реализации интерьера.">
  <main class="services-overview container">
    <header class="services-intro">
      <p class="eyebrow">Услуги студии</p>
      <h1>Выберите глубину работы с пространством</h1>
      <p>Можно решить отдельную планировочную задачу, собрать полный проект или подключить студию к реализации. Ниже — разница в результате и уровне участия.</p>
    </header>

    <section class="service-choice" aria-labelledby="service-choice-title">
      <div class="section-heading">
        <p class="eyebrow">Пять форматов работы</p>
        <h2 id="service-choice-title">От отдельного решения до сопровождения стройки</h2>
      </div>
      <ol class="service-choice__list">
        {services.map((service,index) => <li>
          <a href={sitePath.service(service.slug)}>
            <span class="service-choice__number">{String(index + 1).padStart(2,'0')}</span>
            <div class="service-choice__name"><h3>{service.title}</h3><p>{service.lead}</p></div>
            <dl>
              <div><dt>Подходит, если</dt><dd>{service.audience}</dd></div>
              <div><dt>Участие студии</dt><dd>{service.participation}</dd></div>
              <div><dt>В результате</dt><dd>{service.result}</dd></div>
            </dl>
            <div class="service-choice__meta">
              <span><b>Срок ориентировочно</b>{service.term}</span>
              <span><b>Стоимость ориентировочно</b>{service.price}</span>
              <ArrowIcon />
            </div>
          </a>
        </li>)}
      </ol>
    </section>

    <section class="deliverables" aria-labelledby="deliverables-title">
      <header>
        <p class="eyebrow">Что остаётся у вас</p>
        <h2 id="deliverables-title">Не набор картинок, а материалы для следующего шага</h2>
      </header>
      <ol>
        {serviceDeliverables.map(item => <li><span>{item.number}</span><h3>{item.title}</h3><p>{item.text}</p></li>)}
      </ol>
    </section>

    <ProjectCalculator />

    <section class="project-proof" aria-labelledby="project-proof-title">
      <header>
        <p class="eyebrow">Доказательства в проектах</p>
        <h2 id="project-proof-title">Как проектные решения читаются в пространстве</h2>
        <p>Кейсы показывают не отзывы, а связь задачи, выбранного приёма и результата.</p>
      </header>
      {evidenceItems.map((item,index) => <ServiceEvidence
        href={sitePath.project(item.project.slug)}
        label={item.label}
        title={item.title}
        text={item.text}
        projectTitle={item.project.title}
        image={item.image}
        alt={item.alt}
        reverse={index % 2 === 1}
      />)}
    </section>

    <section class="service-cta">
      <div><p class="eyebrow">Первый разговор</p><h2>Определим достаточный состав работы</h2><p>Если формат пока неочевиден, начнём с задачи, плана и текущего состояния объекта.</p></div>
      <Button href={sitePath.contact()}>Обсудить проект</Button>
    </section>
  </main>
</BaseLayout>

<style>
  .services-overview { padding:var(--space-8) 0; }
  h1,h2,h3 { font-family:var(--font-display); font-weight:400; letter-spacing:-.03em; }
  .services-intro { display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); padding-bottom:var(--section-space); }
  .services-intro .eyebrow { grid-column:1 / span 3; padding-top:12px; }
  .services-intro h1 { font-size:clamp(3rem,6vw,5.25rem); grid-column:4 / span 7; line-height:1.04; margin:0; max-width:12ch; }
  .services-intro > p:last-child { align-self:end; color:var(--muted); grid-column:10 / span 3; line-height:1.65; margin:0 0 8px; }
  .section-heading { display:grid; gap:var(--grid-gap); grid-template-columns:3fr 9fr; padding-bottom:var(--space-5); }
  .section-heading h2,.deliverables h2,.project-proof h2,.service-cta h2 { font-size:var(--title-section); line-height:1.12; margin:0; }
  .section-heading h2 { max-width:19ch; }
  .service-choice__list { border-top:1px solid var(--line); list-style:none; margin:0; padding:0; }
  .service-choice__list > li { border-bottom:1px solid var(--line); }
  .service-choice__list a { display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); padding:var(--space-5) 0; text-decoration:none; }
  .service-choice__number { color:var(--accent-ink); font-size:var(--text-xs); font-weight:700; grid-column:1; padding-top:8px; }
  .service-choice__name { grid-column:2 / span 3; }
  .service-choice__name h3 { font-size:clamp(1.55rem,2.4vw,2.25rem); line-height:1.15; margin:0; }
  .service-choice__name p { color:var(--muted); font-size:var(--text-sm); line-height:1.6; margin:var(--space-2) 0 0; max-width:30ch; }
  .service-choice dl { display:grid; gap:var(--space-3); grid-column:5 / span 5; margin:0; }
  .service-choice dl > div { display:grid; gap:var(--space-2); grid-template-columns:110px 1fr; }
  .service-choice dt,.service-choice__meta b { color:var(--muted); font-size:var(--text-xs); font-weight:500; line-height:1.45; }
  .service-choice dd { font-size:var(--text-sm); line-height:1.55; margin:0; }
  .service-choice__meta { display:flex; flex-direction:column; gap:var(--space-3); grid-column:10 / span 3; min-width:0; }
  .service-choice__meta span { font-size:var(--text-sm); line-height:1.45; }
  .service-choice__meta b { display:block; margin-bottom:3px; }
  .service-choice__meta :global(.icon-arrow) { margin-top:auto; transition:transform var(--duration-fast) var(--ease-ui); }
  .service-choice a:hover .service-choice__meta :global(.icon-arrow),.service-choice a:focus-visible .service-choice__meta :global(.icon-arrow) { transform:translateX(4px); }
  .deliverables { border-top:1px solid var(--line); display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); margin-top:var(--section-space); padding-top:var(--space-7); }
  .deliverables > header { grid-column:1 / span 5; }
  .deliverables h2 { margin-top:var(--space-2); max-width:16ch; }
  .deliverables ol { display:grid; gap:0; grid-column:7 / span 6; list-style:none; margin:0; padding:0; }
  .deliverables li { border-top:1px solid var(--line); display:grid; gap:var(--space-3); grid-template-columns:36px 1fr; padding:var(--space-4) 0; }
  .deliverables li:first-child { border-top:0; padding-top:0; }
  .deliverables li span { color:var(--accent-ink); font-size:var(--text-xs); font-weight:700; padding-top:5px; }
  .deliverables h3 { font-size:clamp(1.35rem,2vw,1.75rem); margin:0; }
  .deliverables li p { color:var(--muted); grid-column:2; line-height:1.65; margin:0; max-width:42ch; }
  :global(.calculator) { margin-top:var(--section-space); }
  .project-proof { margin-top:var(--section-space); }
  .project-proof > header { display:grid; gap:var(--grid-gap); grid-template-columns:var(--grid-columns); padding-bottom:var(--space-5); }
  .project-proof > header .eyebrow { grid-column:1 / span 3; }
  .project-proof > header h2 { grid-column:4 / span 6; max-width:17ch; }
  .project-proof > header > p:last-child { color:var(--muted); grid-column:10 / span 3; line-height:1.65; margin:0; }
  .service-cta { align-items:end; border-top:1px solid var(--line); display:flex; justify-content:space-between; margin-top:var(--section-space); padding-top:var(--space-7); }
  .service-cta h2 { margin:var(--space-2) 0 var(--space-3); max-width:15ch; }
  .service-cta > div > p:last-child { color:var(--muted); line-height:1.65; margin:0; max-width:44ch; }
  @media(max-width:1023px){
    .services-intro h1 { grid-column:4 / span 9; }
    .services-intro > p:last-child { grid-column:4 / span 7; margin-top:var(--space-4); }
    .service-choice__name { grid-column:2 / span 4; }
    .service-choice dl { grid-column:6 / span 4; }
    .service-choice dl > div { display:block; }
    .service-choice dt { display:block; margin-bottom:4px; }
    .project-proof > header h2 { grid-column:4 / span 8; }
    .project-proof > header > p:last-child { grid-column:4 / span 6; margin-top:var(--space-3); }
  }
  @media(max-width:767px){
    .services-overview { padding:var(--space-6) 0; }
    .services-intro,.section-heading,.deliverables,.project-proof > header { display:block; }
    .services-intro h1 { font-size:clamp(2.65rem,12vw,3.5rem); margin-top:var(--space-2); overflow-wrap:anywhere; }
    .services-intro > p:last-child { margin-top:var(--space-4); }
    .services-intro { padding-bottom:var(--space-7); }
    .section-heading { padding-bottom:var(--space-4); }
    .section-heading h2,.deliverables h2,.project-proof h2,.service-cta h2 { font-size:2.35rem; margin-top:var(--space-2); }
    .service-choice__list a { display:grid; gap:var(--space-3); grid-template-columns:34px 1fr; padding:var(--space-5) 0; }
    .service-choice__number { grid-column:1; }
    .service-choice__name,.service-choice dl,.service-choice__meta { grid-column:2; }
    .service-choice dl { margin-top:var(--space-2); }
    .service-choice dl > div { display:block; }
    .service-choice__meta { border-top:1px solid var(--line); display:grid; grid-template-columns:1fr 1fr; padding-top:var(--space-3); }
    .service-choice__meta :global(.icon-arrow) { align-self:end; grid-column:2; justify-self:end; }
    .deliverables { margin-top:var(--space-7); padding-top:var(--space-6); }
    .deliverables ol { margin-top:var(--space-5); }
    .deliverables li:first-child { border-top:1px solid var(--line); padding-top:var(--space-4); }
    :global(.calculator),.project-proof,.service-cta { margin-top:var(--space-7); }
    .project-proof > header > p:last-child { margin-top:var(--space-3); }
    .service-cta { align-items:start; display:block; padding-top:var(--space-6); }
    .service-cta :global(.button) { margin-top:var(--space-5); width:100%; }
  }
</style>
