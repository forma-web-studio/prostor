---
import BaseLayout from '../layouts/BaseLayout.astro'; import DemoInquiry from '../components/DemoInquiry.astro';
---
<BaseLayout title="Сводка проекта — ПРОСТОР" description="Локальная форма для подготовки сводки об интерьерном проекте."><section class="contact container"><header class="contact__intro"><p class="eyebrow">Сводка проекта</p><h1>Начнём с главного</h1><p>Добавьте имя и известные параметры проекта. Сайт соберёт их в текст для копирования, но ничего не отправит.</p></header><div class="contact__form"><DemoInquiry /></div><aside class="contact__details" aria-label="Как работает сводка"><div class="details"><p><b>1. Заполните</b>Укажите только то, что уже известно.</p><p><b>2. Проверьте</b>Готовая сводка покажет все заполненные пункты.</p><p><b>3. Скопируйте</b>Передайте текст по выбранному вами каналу.</p></div><div class="arrival"><span>Граница формы</span><strong>Ничего не отправляется</strong><p>Данные и названия файлов остаются в текущем окне. Файлы не читаются и не передаются.</p></div></aside></section></BaseLayout>
<style>.contact{display:grid;gap:0 clamp(42px,6vw,84px);grid-template-columns:minmax(240px,4fr) minmax(0,8fr);padding:72px 0 96px}.contact__intro{grid-column:1;max-width:36ch}.contact__form{grid-column:2;grid-row:1 / span 2;max-width:780px}.contact__details{align-self:start;grid-column:1;margin-top:54px}.contact h1{font-family:Prata,Georgia,serif;font-size:clamp(42px,4.6vw,64px);font-weight:400;letter-spacing:-.02em;line-height:1.06;margin:12px 0 24px}.contact__intro>p:not(.eyebrow){color:var(--muted);margin:0}.details{border-top:1px solid var(--line);padding-top:18px}.details p{color:var(--muted);font-size:14px;margin:0 0 16px}.details b{color:var(--ink);display:block;font-size:11px;letter-spacing:.08em;margin-bottom:4px;text-transform:uppercase}.details a{color:var(--ink)}.arrival{background:var(--surface-muted);border-left:2px solid var(--accent);margin-top:32px;padding:22px}.arrival span{color:var(--muted);display:block;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.arrival strong{display:block;font-family:var(--font-display);font-size:21px;font-weight:400;margin-top:8px}.arrival p{color:var(--muted);font-size:13px;line-height:1.55;margin:9px 0 0}@media(min-width:768px) and (max-width:1099px){.contact{gap:var(--space-6) var(--grid-gap);grid-template-columns:var(--grid-columns);padding:var(--space-7) 0 var(--space-8)}.contact__intro{display:grid;gap:var(--grid-gap);grid-column:1/-1;grid-template-columns:var(--grid-columns);max-width:none}.contact__intro .eyebrow,.contact__intro h1{grid-column:1/span 5}.contact__intro h1{margin:var(--space-2) 0 0}.contact__intro>p:not(.eyebrow){align-self:end;grid-column:7/span 6;grid-row:1/span 2;max-width:40ch}.contact__details{grid-column:1/span 4;margin-top:0}.contact__form{grid-column:5/span 8;grid-row:2;max-width:none}.arrival{padding:18px}}@media(max-width:767px){.contact{display:flex;flex-direction:column;padding:48px 0 64px}.contact h1{font-size:clamp(38px,12vw,52px)}.contact__form{margin-top:38px;order:2}.contact__details{margin-top:46px;order:3}.details p{font-size:16px}.details b,.arrival span{font-size:13px}.arrival{margin-top:26px}.arrival p{font-size:14px}}</style>


