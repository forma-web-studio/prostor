---
import BaseLayout from '../layouts/BaseLayout.astro'; import DemoInquiry from '../components/DemoInquiry.astro'; import { contacts } from '../data/site';
---
<BaseLayout title="Консультация — ПРОСТОР" description="Запись на вводную консультацию по интерьерному проекту в Санкт-Петербурге."><section class="contact container"><header class="contact__intro"><p class="eyebrow">Первый разговор</p><h1>Обсудим ваш проект</h1><p>Выберите предварительное время и расскажите о пространстве. Перед сводкой можно вернуться к любому шагу.</p></header><div class="contact__form"><DemoInquiry /></div><aside class="contact__details"><div class="details"><p><b>Студия</b>{contacts.address}</p><p><b>Время</b>{contacts.hours}</p><p><b>Территория</b>{contacts.territory}</p><p><b>Связь</b>{contacts.phone}<br />{contacts.email}</p></div><div class="map" aria-label="Схема расположения студии на Петроградской стороне"><span>ПЕТРОГРАДСКАЯ СТОРОНА</span><b class="street street--one">Каменноостровский проспект</b><b class="street street--two">Большая Монетная</b><b class="street street--three">Малая Посадская</b><i></i><em>Студия ПРОСТОР</em><small>Ориентир: Каменноостровский проспект · точку встречи подтверждаем при записи.</small></div></aside></section></BaseLayout>
<style>.contact{display:grid;gap:0 64px;grid-template-columns:4fr 7fr;padding:72px 0}.contact__intro{grid-column:1;max-width:35ch}.contact__form{grid-column:2;grid-row:1 / span 2;max-width:680px}.contact__details{align-self:end;grid-column:1;margin-top:42px}.contact h1{font-family:Prata,Georgia,serif;font-size:clamp(38px,4vw,52px);font-weight:400;line-height:1.1;margin:12px 0 24px}.contact__intro>p:not(.eyebrow){margin:0}.details{border-top:1px solid var(--line);padding-top:16px}.details p{color:var(--muted);font-size:14px;margin:0 0 13px}.details b{color:var(--ink);display:block;font-size:11px;letter-spacing:.08em;margin-bottom:3px;text-transform:uppercase}.map{background:linear-gradient(145deg,#e3dfd5,#c7cabc);height:245px;margin-top:38px;overflow:hidden;padding:24px;position:relative}.map:before,.map:after{background:#f6f3ec;content:"";height:30px;left:-30px;position:absolute;top:95px;transform:rotate(-18deg);width:360px}.map:after{top:165px;transform:rotate(22deg)}.map span{color:#697260;font-size:11px;letter-spacing:.16em;position:relative;z-index:1}.map i{background:var(--ink);border:5px solid #f5f1e9;border-radius:50%;height:20px;left:48%;position:absolute;top:42%;width:20px;z-index:2}.map em{bottom:34%;font-size:12px;font-style:normal;left:16px;position:absolute;z-index:2}.street{background:rgba(246,243,236,.78);color:#697260;font-size:9px;font-weight:400;letter-spacing:.02em;padding:4px 7px;position:absolute;z-index:1}.street--one{right:14px;top:46px;transform:rotate(-18deg)}.street--two{left:22px;top:126px;transform:rotate(17deg)}.street--three{right:18px;top:174px;transform:rotate(-8deg)}.map small{bottom:13px;color:var(--muted);font-size:10px;left:24px;position:absolute;z-index:2}@media(max-width:767px){.contact{display:flex;flex-direction:column;padding:48px 0}.contact__form{margin-top:42px;order:2}.contact__details{margin-top:48px;order:3}.map{height:220px}}</style>


