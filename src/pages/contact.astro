---
import BaseLayout from '../layouts/BaseLayout.astro'; import DemoInquiry from '../components/DemoInquiry.astro'; import { contacts } from '../data/site';
---
<BaseLayout title="Консультация — ПРОСТОР" description="Короткая форма для подготовки первого разговора об интерьерном проекте."><section class="contact container"><header class="contact__intro"><p class="eyebrow">Первый разговор</p><h1>Начнём с главного</h1><p>Оставьте имя и один способ связи. Параметры проекта можно добавить по желанию — ничего не отправится без отдельного контакта со студией.</p></header><div class="contact__form"><DemoInquiry /></div><aside class="contact__details" aria-label="Контакты студии"><div class="details"><p><b>Связь</b><a href={`tel:${contacts.phone.replace(/[^+\d]/g, '')}`}>{contacts.phone}</a><br /><a href={`mailto:${contacts.email}`}>{contacts.email}</a></p><p><b>Студия</b>{contacts.address}</p><p><b>Время</b>{contacts.hours}</p><p><b>Территория</b>{contacts.territory}</p></div><div class="arrival"><span>Ориентир для встречи</span><strong>Петроградская сторона</strong><p>Каменноостровский проспект, 38. Точное время и формат сначала согласуем по телефону или email.</p></div></aside></section></BaseLayout>
<style>.contact{display:grid;gap:0 clamp(42px,6vw,84px);grid-template-columns:minmax(240px,4fr) minmax(0,8fr);padding:72px 0 96px}.contact__intro{grid-column:1;max-width:36ch}.contact__form{grid-column:2;grid-row:1 / span 2;max-width:780px}.contact__details{align-self:start;grid-column:1;margin-top:54px}.contact h1{font-family:Prata,Georgia,serif;font-size:clamp(42px,4.6vw,64px);font-weight:400;letter-spacing:-.02em;line-height:1.06;margin:12px 0 24px}.contact__intro>p:not(.eyebrow){color:var(--muted);margin:0}.details{border-top:1px solid var(--line);padding-top:18px}.details p{color:var(--muted);font-size:14px;margin:0 0 16px}.details b{color:var(--ink);display:block;font-size:11px;letter-spacing:.08em;margin-bottom:4px;text-transform:uppercase}.details a{color:var(--ink)}.arrival{background:var(--surface-muted);border-left:2px solid var(--accent);margin-top:32px;padding:22px}.arrival span{color:var(--muted);display:block;font-size:11px;letter-spacing:.09em;text-transform:uppercase}.arrival strong{display:block;font-family:var(--font-display);font-size:21px;font-weight:400;margin-top:8px}.arrival p{color:var(--muted);font-size:13px;line-height:1.55;margin:9px 0 0}@media(max-width:900px){.contact{gap:42px;grid-template-columns:minmax(210px,3fr) minmax(0,5fr)}}@media(max-width:767px){.contact{display:flex;flex-direction:column;padding:48px 0 64px}.contact h1{font-size:clamp(38px,12vw,52px)}.contact__form{margin-top:38px;order:2}.contact__details{margin-top:46px;order:3}.arrival{margin-top:26px}}</style>


