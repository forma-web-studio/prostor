---
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import { withBase } from '../utils/urls';
---
<BaseLayout title="Страница не найдена — ПРОСТОР" description="Страница не найдена."><section class="not-found container"><p class="eyebrow">404</p><h1>Эта страница пока не появилась.</h1><p>Посмотрите проекты квартир и загородных домов.</p><Button href={withBase('/#projects')}>К избранным</Button></section></BaseLayout>
<style>.not-found { min-height:55vh; padding-top:var(--space-9); } h1 { font-family:Prata,Georgia,serif; font-size:clamp(48px,7vw,88px); font-weight:400; line-height:1.06; margin:12px 0 24px; max-width:11ch; } .not-found > p:not(.eyebrow) { max-width:42ch; } .button { margin-top:20px; }</style>
