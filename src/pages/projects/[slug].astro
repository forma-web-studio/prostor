---
import BaseLayout from '../../layouts/BaseLayout.astro';
import FlagshipProjectCase from '../../components/FlagshipProjectCase.astro';
import StandardProjectCase from '../../components/StandardProjectCase.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((project) => ({ params:{ slug:project.slug }, props:{ project } }));
}

const { project } = Astro.props;
const next = projects.find((item) => item.slug === project.caseStudy.nextProjectSlug);
if (!next) throw new Error(`Unknown next project: ${project.caseStudy.nextProjectSlug}`);
---

<BaseLayout title={`${project.title} — ПРОСТОР`} description={project.summary}>
  {project.caseStudy.variant === 'flagship'
    ? <FlagshipProjectCase project={project} next={next} />
    : <StandardProjectCase project={project} next={next} />}
</BaseLayout>
