---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../utils/urls';
import manropeCyrillic from '@fontsource-variable/manrope/files/manrope-cyrillic-wght-normal.woff2?url';
import manropeLatin from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import prataCyrillic from '@fontsource/prata/files/prata-cyrillic-400-normal.woff2?url';
import prataLatin from '@fontsource/prata/files/prata-latin-400-normal.woff2?url';
import { absoluteUrl, isSiteIndexable, withDeploymentBase } from '../utils/seo';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogType?: 'website' | 'article';
}

const { title, description, noindex = false, ogType = 'website' } = Astro.props;
const site = Astro.site;
const siteIndexable = isSiteIndexable(site);
const shouldNoIndex = noindex || !siteIndexable;
const canonical = site && !noindex ? absoluteUrl(site, Astro.url.pathname) : undefined;
const socialImage = site ? absoluteUrl(site, withDeploymentBase('/og/prostor.jpg'), false) : undefined;
const siteRoot = site ? absoluteUrl(site, import.meta.env.BASE_URL) : undefined;
const structuredData = canonical && socialImage && siteRoot && !shouldNoIndex ? {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description,
  url: canonical,
  inLanguage: 'ru-RU',
  isPartOf: {
    '@type': 'WebSite',
    name: 'ПРОСТОР',
    url: siteRoot,
  },
  primaryImageOfPage: {
    '@type': 'ImageObject',
    url: socialImage,
    width: 1200,
    height: 630,
  },
} : undefined;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="preload" href={manropeCyrillic} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={manropeLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={prataCyrillic} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={prataLatin} as="font" type="font/woff2" crossorigin="anonymous" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    {socialImage && <meta property="og:image:alt" content="ПРОСТОР — интерьерные концепции квартир и домов" />}
    {socialImage && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="robots" content={shouldNoIndex ? 'noindex, nofollow' : 'index, follow'} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} is:inline />}
    <title>{title}</title>
  </head>
  <body class="site-shell">
    <a class="skip-link" href="#main">Перейти к содержанию</a>
    <Header />
    <main id="main" class="site-main" tabindex="-1"><slot /></main>
    <Footer />
    <script src="../scripts/project-transitions.ts"></script>
    <script>
      const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const editorialGroups = [
        '.hero > h1, .hero > .hero__copy',
        '.section-title, .project-grid__item',
        '.approach__heading, .approach__body',
        '.process-section > .eyebrow, .process-section > h2',
        '.cta > div',
        '.studio > .eyebrow, .studio > h1',
        '.focus > div, .focus > figure',
        '.services > .eyebrow, .services > h1',
        '.services__list',
        '.project-case__header, .project-case-media, .case-overview, .case-decisions, .plan-to-space, .case-evidence-section, .case-materials, .case-facts, .case-next, .case-cta',
        '.service > .eyebrow, .service > h1, .service > .lead, .facts'
      ];
      const seenTargets = new Set<HTMLElement>();
      const revealGroups: HTMLElement[][] = [];
      editorialGroups.forEach((selector) => {
        const groupTargets = [...document.querySelectorAll<HTMLElement>(selector)].filter((element) => !seenTargets.has(element));
        groupTargets.forEach((element) => seenTargets.add(element));
        for (let index = 0; index < groupTargets.length; index += 2) revealGroups.push(groupTargets.slice(index, index + 2));
      });
      const imageTargets = [...document.querySelectorAll<HTMLElement>('.hero__media, .cover__media')];
      imageTargets.forEach((element) => revealGroups.push([element]));
      if (!reducedMotion && 'IntersectionObserver' in window) {
        const groupByTarget = new Map<HTMLElement, HTMLElement[]>();
        revealGroups.forEach((group, groupIndex) => group.forEach((element, elementIndex) => {
          element.dataset.revealGroup = String(groupIndex);
          if (imageTargets.includes(element)) element.dataset.imageReveal = '';
          else {
            element.dataset.reveal = '';
            if (elementIndex === 1) element.style.setProperty('--reveal-delay', '70ms');
          }
          groupByTarget.set(element, group);
        }));
        const revealedGroups = new Set<HTMLElement[]>();
        let observer: IntersectionObserver;
        const revealGroup = (group: HTMLElement[], immediately = false) => {
          if (revealedGroups.has(group)) return;
          revealedGroups.add(group);
          group.forEach((element) => {
            if (immediately) element.style.setProperty('transition', 'none');
            element.classList.add('is-revealed');
            observer.unobserve(element);
          });
          if (immediately) {
            requestAnimationFrame(() => requestAnimationFrame(() => group.forEach((element) => element.style.removeProperty('transition'))));
          }
        };
        observer = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const group = groupByTarget.get(entry.target as HTMLElement);
          if (group) revealGroup(group);
        }), { rootMargin:'0px 0px 12% 0px', threshold:.04 });
        groupByTarget.forEach((_, element) => observer.observe(element));
        requestAnimationFrame(() => document.documentElement.classList.add('motion-ready'));
        window.setTimeout(() => revealGroups.forEach((group) => revealGroup(group)), 520);
        document.addEventListener('focusin', (event) => {
          const focusedGroup = [...groupByTarget.entries()].find(([element]) => element.contains(event.target as Node))?.[1];
          if (!focusedGroup || revealedGroups.has(focusedGroup)) return;
          revealGroup(focusedGroup, true);
        });
      }
    </script>
  </body>
</html>
